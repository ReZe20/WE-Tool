<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WE_Tool</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Win2D 要求显式平台:默认(AnyCPU)构建按 x64 处理(Win2D targets 检查 Platform 属性),显式 x86/ARM64 发布不受影响 -->
    <Platform Condition="'$(Platform)' == 'AnyCPU'">x64</Platform>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <Version>0.5.3</Version>
    <!-- Release 下 WinUI 默认禁用反射序列化,导致 config.json 读写失败(实测:设置全部丢失);显式开启 -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <Authors>ReZe20</Authors>
    <Copyright>Copyright © 2026 ReZe20</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- AOT/Trim 兼容:禁用 XAML 类型反射和绑定诊断(避免 0xC000027B stowed exception) -->
    <EnableTypeInfoReflection>false</EnableTypeInfoReflection>
    <EnableBindingDiagnostics>false</EnableBindingDiagnostics>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Assets\noPreview.png" />
    <None Remove="LoadPapers.xaml" />
    <None Remove="Views\Info.xaml" />
    <None Remove="Papers.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="CommunityToolkit.WinUI.Animations" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="Facepunch.Steamworks" Version="2.3.3" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.3" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="2.0.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.6" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.4.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.6" />
    <!-- AOT:CsWinRT source generator (matches WinUI 2.3.6) -->
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
    <PackageReference Include="SkiaSharp.Views.WinUI" Version="4.151.1" />
    <PackageReference Include="WinUIEx" Version="2.9.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- 复制 Steamworks 的 steam_api64.dll 到输出目录 -->
    <Content Include="$(NuGetPackageRoot)facepunch.steamworks\2.3.3\content\steam_api64.dll">
      <Link>steam_api64.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!-- SteamworksBridge 部署:应用对桥接无编译期引用(仅进程调用),不能 ProjectReference
       (自包含发布会报 NETSDK1150);构建/发布时构建桥接并把输出拷进目标目录 -->
  <Target Name="CopySteamworksBridge" AfterTargets="Build;Publish" BeforeTargets="PackageWithLauncher" Condition="Exists('$(MSBuildThisFileDirectory)..\SteamworksBridge\SteamworksBridge.csproj')">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\SteamworksBridge\SteamworksBridge.csproj" Targets="Restore;Build" Properties="Configuration=$(Configuration)" />
    <ItemGroup>
      <BridgeOutput Include="$(MSBuildThisFileDirectory)..\SteamworksBridge\bin\$(Configuration)\net8.0\**\*" Exclude="$(MSBuildThisFileDirectory)..\SteamworksBridge\bin\$(Configuration)\net8.0\*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(BridgeOutput)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(BridgeOutput)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != ''" />
  </Target>
  <!-- 从 external/repkg_Re 仓库 csproj 读取目标后端版本,构建时生成 RepkgVersion.g.cs 常量供运行时校验。
       不依赖 SDK 的 AssemblyMetadata 管线(其特性转换发生在 CreateGeneratedAssemblyInfoInputsCacheFile,
       顺序敏感且增量缓存易跳过);直接生成源码文件最稳 -->
  <Target Name="InjectRepkgVersion" BeforeTargets="MarkupCompilePass1;CoreCompile" Condition="Exists('$(MSBuildThisFileDirectory)..\external\repkg_Re\RePKG_Re\RePKG_Re.csproj')">
    <XmlPeek XmlInputPath="$(MSBuildThisFileDirectory)..\external\repkg_Re\RePKG_Re\RePKG_Re.csproj" Query="/Project/PropertyGroup/Version/text()">
      <Output TaskParameter="Result" PropertyName="RepkgVersion" />
    </XmlPeek>
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)RepkgVersion.g.cs" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)RepkgVersion.g.cs" Lines="namespace WE_Tool { internal static class RepkgVersionInfo { public const string Required = &quot;$(RepkgVersion)&quot;%3B } }" Overwrite="true" />
  </Target>
  <!-- 翻译完成度:构建时统计各语言 resw 填充比例,生成 TranslationStatus.g.cs 常量
       (基准 = zh-CN 完整键集;zh-CN 恒为 100%) -->
  <UsingTask TaskName="ComputeTranslationStatus" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <StringsDir ParameterType="System.String" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Xml.Linq" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
        var localeNames = new Dictionary<string, string>
        {
            { "zh-CN", "简体中文" }, { "en-US", "English" }, { "de-DE", "Deutsch" },
            { "es-ES", "Español" }, { "fr-FR", "Français" }, { "it-IT", "Italiano" },
            { "ja-JP", "日本語" }, { "ko-KR", "한국어" }, { "pt-BR", "Português (Brasil)" },
            { "ru-RU", "Русский" }, { "zh-TW", "繁體中文" },
        };
        var locales = Directory.GetDirectories(StringsDir)
            .Select(d => Path.GetFileName(d))
            .Where(l => localeNames.ContainsKey(l))
            .OrderBy(l => l != "zh-CN") // zh-CN 排第一
            .ThenBy(l => l)
            .ToList();

        // 基准 = zh-CN 完整键集
        var zhKeys = XDocument.Load(Path.Combine(StringsDir, "zh-CN", "Resources.resw"))
            .Root.Elements("data").Select(d => d.Attribute("name")?.Value)
            .Where(n => n != null).ToList();

        var sb = new StringBuilder();
        sb.AppendLine("namespace WE_Tool");
        sb.AppendLine("{");
        sb.AppendLine("    internal static class TranslationStatusInfo");
        sb.AppendLine("    {");
        sb.AppendLine("        public static readonly Models.TranslationStatusItem[] Items = new[]");
        sb.AppendLine("        {");
        foreach (var locale in locales)
        {
            var doc = XDocument.Load(Path.Combine(StringsDir, locale, "Resources.resw"));
            var filled = doc.Root.Elements("data")
                .Where(d => zhKeys.Contains(d.Attribute("name")?.Value))
                .Count(d => !string.IsNullOrWhiteSpace(d.Element("value")?.Value));
            var percent = zhKeys.Count == 0 ? 100 : (int)Math.Round(filled * 100.0 / zhKeys.Count);
            sb.AppendLine(string.Format(
                "            new Models.TranslationStatusItem {{ Locale = \"{0}\", Name = \"{1}\", Percent = {2} }},",
                locale, localeNames[locale], percent));
        }
        sb.AppendLine("        };");
        sb.AppendLine("    }");
        sb.AppendLine("}");
        File.WriteAllText(OutputFile, sb.ToString(), new UTF8Encoding(true)); // BOM:csc 按 UTF-8 读,防 CJK 乱码
        Log.LogMessage(MessageImportance.High, "TranslationStatus.g.cs 已生成: {0} 个语言", locales.Count);
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="InjectTranslationStatus" BeforeTargets="MarkupCompilePass1;CoreCompile">
    <ComputeTranslationStatus StringsDir="$(MSBuildThisFileDirectory)Strings" OutputFile="$(IntermediateOutputPath)TranslationStatus.g.cs" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)TranslationStatus.g.cs" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Content Include="..\external\repkg_Re\LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>repkg\LICENSE</Link>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\Contributors.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\ContributorsRepkg.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Page Update="Views\Info.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="LoadPapers.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="Papers.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="Views\Settings.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="Views\Cleanup.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="Views\InstalledComponents.xaml">
