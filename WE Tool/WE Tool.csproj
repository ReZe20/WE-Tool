  </ItemGroup>
  <ItemGroup>
    <None Include="Strings\**\*.resw">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- GPL-3.0 要求分发时附带许可证全文 -->
    <None Include="$(ProjectDir)..\LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>LICENSE</Link>
    </None>
    <!-- 第三方组件许可声明 -->
    <None Include="$(ProjectDir)..\THIRD-PARTY-NOTICES.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>THIRD-PARTY-NOTICES.txt</Link>
    </None>
  </ItemGroup>

    <!-- [路线二] NativeAOT 静态链接 Skia 主体(2026-08-24 实测通过):
         发布时把精简版 Skia 静态库(约 45.6MB,本机构建产物 skia-engine/out/min-gif/*.lib)
         直接链进 WE_Tool.exe,并通过 .def 导出表把 937 个 sk_* 符号烙进 exe 本体;
         运行时 SkiaStaticLink.cs 的 DllImportResolver 把 "libSkiaSharp" 解析到进程自身。
         -> 发布目录不再携带 libSkiaSharp.dll,Skia 完全长在 exe 里。
         仅 Release AOT 发布生效;Debug 日常调试不受影响(仍走 NuGet 的 dll)。
         注意:.def 严禁出现 LIBRARY 行(会把 exe 烙成 DLL 格式,Windows 拒载)。
         注:SkiaSharp.Views.WinUI.Native.dll 保留官方原版不融入(2026-08-24 用户决定) -->
    <ItemGroup Condition="'$(PublishAot)' == 'true' And '$(Configuration)' != 'Debug'">
      <LinkerArg Include="/DEF:&quot;$(ProjectDir)..\native\skia-min-gif\libSkiaSharp.def&quot;" />
      <NativeLibrary Include="$(SkiaStaticLibDir)SkiaSharp.lib" Condition="Exists('$(SkiaStaticLibDir)SkiaSharp.lib')" />
      <NativeLibrary Include="$(SkiaStaticLibDir)skia.lib" Condition="Exists('$(SkiaStaticLibDir)skia.lib')" />
      <NativeLibrary Include="$(SkiaStaticLibDir)skottie.lib" Condition="Exists('$(SkiaStaticLibDir)skottie.lib')" />
      <NativeLibrary Include="$(SkiaStaticLibDir)sksg.lib" Condition="Exists('$(SkiaStaticLibDir)sksg.lib')" />
      <NativeLibrary Include="$(SkiaStaticLibDir)skresources.lib" Condition="Exists('$(SkiaStaticLibDir)skresources.lib')" />
      <NativeLibrary Include="$(SkiaStaticLibDir)jsonreader.lib" Condition="Exists('$(SkiaStaticLibDir)jsonreader.lib')" />
      <NativeLibrary Include="$(SkiaStaticLibDir)skshaper.lib" Condition="Exists('$(SkiaStaticLibDir)skshaper.lib')" />
      <!-- Windows 系统库:DirectWrite 字体管理 + XPS 字体子集化 -->
            <NativeLibrary Include="dwrite.lib" />
            <NativeLibrary Include="fontsub.lib" />
          </ItemGroup>

          <!-- [路线二] Debug/非 AOT 调试时排除 SkiaStaticLink.cs:resolver 会把 P/Invoke 指到无导出表的 exe,
               导致版本检查读不到原生版本(TypeInitializationException)。仅 AOT 发布时才编译该文件。 -->
          <ItemGroup Condition="'$(PublishAot)' != 'true' Or '$(Configuration)' == 'Debug'">
            <Compile Remove="SkiaStaticLink.cs" />
          </ItemGroup>

    <!-- Publish repkg-Re（单文件 exe + THIRD-PARTY-NOTICES.txt）并复制到 repkg/ 供 CLI 调用 -->
  <Target Name="BuildRepkg" BeforeTargets="BeforeBuild">
    <Exec Command="dotnet publish &quot;$(ProjectDir)..\external\repkg_Re\RePKG_Re\RePKG_Re.csproj&quot; -c $(Configuration) -p:PublishProfile=FolderProfile" />
    <ItemGroup>
      <RepkgOutput Include="$(ProjectDir)..\external\repkg_Re\RePKG_Re\bin\publish\*" />
      <!-- 同时声明为 Content，使 repkg 进入 publish 产物（publish 只发布清单内文件） -->
      <Content Include="@(RepkgOutput)">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <Link>repkg\%(Filename)%(Extension)</Link>
      </Content>
    </ItemGroup>
    <Copy SourceFiles="@(RepkgOutput)" DestinationFolder="$(OutputPath)\repkg" />
  </Target>

  <!-- Post-publish: restructure with .NET Framework launcher -->
  <Target Name="PackageWithLauncher" AfterTargets="Publish">
    <PropertyGroup>
      <LauncherProj>$(ProjectDir)..\WE_Tool.Launcher\WE_Tool.Launcher.csproj</LauncherProj>
      <LauncherExe>$(ProjectDir)..\WE_Tool.Launcher\bin\Release\WE_Tool.exe</LauncherExe>
    </PropertyGroup>
    <!-- Build launcher -->
    <Exec Command="dotnet build &quot;$(LauncherProj)&quot; -c Release" />
    <!-- Create app/ and move all files into it in one PowerShell call (先删除旧 app/ 保证重复发布幂等) -->
    <Exec Command="powershell -NoProfile -Command &quot;$p='$(PublishDir)'; $a=Join-Path $p 'app'; if (Test-Path $a) { Remove-Item $a -Recurse -Force }; New-Item -ItemType Directory -Force -Path $a | Out-Null; Get-ChildItem $p -Exclude app | Move-Item -Destination $a -Force&quot;" />
    <!-- Copy launcher EXE to root -->
    <Copy SourceFiles="$(LauncherExe)" DestinationFiles="$(PublishDir)WE_Tool.exe" />
    <!-- 剔除调试符号:SkiaSharp 等原生包自带 .pdb(仅调试用),发布产物不携带,避免体积虚增 -->
    <!-- 剔除 ANGLE 原生库:SkiaGifView 纯 CPU 光栅绘制(SKCodec+SKBitmap+SKXamlCanvas),不创建 GL 上下文;
         libEGL/libGLESv2 系 SkiaSharp.Views.WinUI 的 OpenGL 后端,实测删除后应用显示正常(2026-08-18) -->
    <!-- 剔除 WebView2 三件套:WinUI 子包(Microsoft.WindowsAppSDK.WinUI)在 nuspec 硬性依赖
         Microsoft.Web.WebView2,是无条件附赠的默认组件;本项目源码零 WebView2 调用,纯体积负担
         (Core.dll 767KB + Core.Projection.dll 651KB + WebView2Loader.dll 162KB,2026-08-23 实测定稿) -->
    <!-- 剔除 Microsoft.Windows.SDK.NET.dll(23.7MB):WinRT 投影桥(C# 调 Windows API 的翻译层)。
         AOT 编译后启动路径的 API 已焊进原生 exe,运行时不需要此 dll;实测删除后程序正常
         运行(2026-08-23 用户验证)。若未来某运行时功能异常,可加回 -->
    <ItemGroup>
      <_PublishUnneeded Include="$(PublishDir)**\*.pdb" />
      <_PublishUnneeded Include="$(PublishDir)**\libEGL.dll" />
      <_PublishUnneeded Include="$(PublishDir)**\libGLESv2.dll" />
      <_PublishUnneeded Include="$(PublishDir)**\Microsoft.Web.WebView2.Core.dll" />
      <_PublishUnneeded Include="$(PublishDir)**\Microsoft.Web.WebView2.Core.Projection.dll" />
      <_PublishUnneeded Include="$(PublishDir)**\WebView2Loader.dll" />
      <_PublishUnneeded Include="$(PublishDir)**\Microsoft.Windows.SDK.NET.dll" />
      <!-- 剔除 Windows App SDK 后台任务组件:WE Tool 不用 WinRT 后台任务(自动备份是独立 exe 服务),
           exe 无任何引用,纯附带体积 -->
      <_PublishUnneeded Include="$(PublishDir)**\Microsoft.Windows.ApplicationModel.Background.UniversalBGTask.dll" />
      <!-- [路线二] 剔除 libSkiaSharp.dll:静态链接后 937 个 sk_* 符号焊进 exe 本体,
           运行时经 SkiaStaticLink.cs 的 DllImportResolver 重定向到进程自身;
           此 dll 仅是 NuGet 附带的原生库,不再需要(2026-08-24 实测)。
           注:SkiaSharp.Views.WinUI.Native.dll 保留(激活服务器不做融入) -->
      <_PublishUnneeded Include="$(PublishDir)**\libSkiaSharp.dll" />
    </ItemGroup>
    <Delete Files="@(_PublishUnneeded)" />
    <Message Importance="high" Text="Publish done: $(PublishDir)WE_Tool.exe (launcher) + app/ (已剔除 @(_PublishUnneeded.Count) 项: pdb + ANGLE + WebView2)" />
  </Target>

  <!-- AOT 的 WE_Tool.pdb 由 NativeAOT 在 PackageWithLauncher 之后生成(时序晚,上面的剔除匹配不到),
       独立目标在 PackageWithLauncher 之后执行删除(仅调试用,发布不携带;实测 117.9MB) -->
  <Target Name="DeleteAotPdb" AfterTargets="PackageWithLauncher">
    <Message Importance="high" Text="AOT PDB 检查: $(PublishDir)WE_Tool.pdb" Condition="Exists('$(PublishDir)WE_Tool.pdb')" />
    <Delete Files="$(PublishDir)WE_Tool.pdb" Condition="Exists('$(PublishDir)WE_Tool.pdb')" />
  </Target>

  <!-- [路线二] 发布后把 NuGet 附带的官方 libSkiaSharp.dll 替换为仓库内精简版(native/skia-min-gif/)。
       场景:本机 AOT 静态链接成功→app/ 下无 libSkiaSharp.dll,此处无操作(Exists 保护);
       CI 或静态库缺失时回退 NuGet 官方 dll 模式→app/ 下有官方 dll,此处替换为精简版,
       使发布包体积与本机一致(zip 少 ~2.4MB)。仓库内精简 dll 与 libSkiaSharp.def/配方一起提交,
       clone 后 CI 可直接复用,无需重新编译 Skia。 -->
  <Target Name="ReplaceSkiaDll" BeforeTargets="PackageZip" AfterTargets="PackageWithLauncher;DeleteAotPdb">
    <ItemGroup>
      <_OfficialSkiaDll Include="$(PublishDir)app\libSkiaSharp.dll" Condition="Exists('$(PublishDir)app\libSkiaSharp.dll')" />
    </ItemGroup>
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\native\skia-min-gif\libSkiaSharp.dll"
          DestinationFiles="$(PublishDir)app\libSkiaSharp.dll"
          SkipUnchangedFiles="true"
          Condition="'@(_OfficialSkiaDll)' != '' And Exists('$(MSBuildProjectDirectory)\..\native\skia-min-gif\libSkiaSharp.dll')" />
    <Message Importance="high" Text="libSkiaSharp.dll 已替换为仓库精简版 ($(MSBuildProjectDirectory)\..\native\skia-min-gif\libSkiaSharp.dll)" Condition="'@(_OfficialSkiaDll)' != '' And Exists('$(MSBuildProjectDirectory)\..\native\skia-min-gif\libSkiaSharp.dll')" />
    <Message Importance="high" Text="app/ 下无 libSkiaSharp.dll(AOT 静态链接已内嵌),跳过替换" Condition="'@(_OfficialSkiaDll)' == ''" />
  </Target>

  <!-- 发布完成后自动打包 zip 到 VS 默认发布目录 bin/Package/(与 PublishDir 同级,git 忽略)。
       每次发布自动产出固定位置的分发包,无需手动 Compress-Archive -->
  <Target Name="PackageZip" AfterTargets="DeleteAotPdb">
    <PropertyGroup>
      <ZipName>WE-Tool-$(Version)-portable.zip</ZipName>
      <ZipOut>$(MSBuildProjectDirectory)\bin\Package\$(ZipName)</ZipOut>
      <!-- 未压缩文件夹:与 zip 同名去 .zip,方便直接查看/拷贝 -->
      <FolderOut>$(MSBuildProjectDirectory)\bin\Package\WE-Tool-$(Version)-portable</FolderOut>
    </PropertyGroup>
    <Delete Files="$(ZipOut)" Condition="Exists('$(ZipOut)')" />
    <!-- 极限压缩:优先 7-Zip -mx=9(windows-latest CI 自带 7z;aot 机器码高熵,收益 <1%),
         无 7z 时回退 PowerShell Compress-Archive(本机) -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;&amp; { $ep = '$(PublishDir)'.TrimEnd('\'); $se7en = @($env:ProgramFiles, ${env:ProgramFiles(x86)}, $env:LOCALAPPDATA) | ForEach-Object { Join-Path $_ '7-Zip\7z.exe' } | Where-Object { Test-Path $_ } | Select-Object -First 1; if ($se7en) { Write-Host ('[PackageZip] 7-Zip 极限压缩: ' + $se7en); &amp; $se7en a -tzip -mx=9 -bd -y -- '$(ZipOut)' (Join-Path $ep '*') | Out-Null; if ($LASTEXITCODE -ne 0) { throw ('7z failed: ' + $LASTEXITCODE) } } else { Write-Host '[PackageZip] 未找到 7-Zip,回退 Compress-Archive'; Compress-Archive -Path (Join-Path $ep '*') -DestinationPath '$(ZipOut)' -Force } }&quot;" />
    <!-- 复制未压缩文件夹(排除 pdb;AOT PDB 由 ILC 在发布末尾生成,时序晚于本目标,复制时一并剔除)。
         注意:必须整目录复制保留 app/ 子目录结构,不能用 $(PublishDir)* 通配(会平铺) -->
    <RemoveDir Directories="$(FolderOut)" />
    <Exec Command="powershell -NoProfile -Command &quot;Copy-Item -Path '$(PublishDir)' -Destination '$(FolderOut)' -Recurse -Force; Get-ChildItem '$(FolderOut)' -Recurse -Filter '*.pdb' | Remove-Item -Force&quot;" />
    <Message Importance="high" Text="zip 已生成: $(ZipOut)" />
    <Message Importance="high" Text="未压缩文件夹已生成: $(FolderOut)" />
  </Target>

  <!-- 发布完成后用 Inno Setup 把未压缩文件夹打成单个安装包 setup.exe(bin/Package/,git 忽略)。
       与 zip 并列的第二种发布模式;ISCC 不存在时仅告警跳过(允许只发 zip 的环境)。
       版本号经 /D 注入 iss 脚本,避免双处维护 -->
  <Target Name="PackageInstaller" AfterTargets="PackageZip">
    <PropertyGroup>
      <SetupName>WE-Tool-$(Version)-win-x64-setup.exe</SetupName>
      <SetupOut>$(MSBuildProjectDirectory)\bin\Package\$(SetupName)</SetupOut>
      <IssFile>$(MSBuildProjectDirectory)\..\installer\we-tool.iss</IssFile>
      <!-- 与 PackageZip 的 FolderOut 同一表达式在此重算(那是目标内局部属性,跨目标不可见) -->
      <InstallerSourceRoot>$(MSBuildProjectDirectory)\bin\Package\WE-Tool-$(Version)-portable</InstallerSourceRoot>
    </PropertyGroup>
    <ItemGroup>
      <_IsccCandidates Include="$(LocalAppData)\Programs\Inno Setup 6\ISCC.exe" />
      <_IsccCandidates Include="$(MSBuildProgramFiles32)\Inno Setup 6\ISCC.exe" />
      <_IsccCandidates Include="$(ProgramFiles)\Inno Setup 6\ISCC.exe" />
      <IsccExe Include="@(_IsccCandidates->'%(Identity)')" Condition="Exists('%(_IsccCandidates.Identity)')" />
    </ItemGroup>
    <Error Text="找不到 ISCC.exe(Inno Setup 6),无法生成安装包;或安装 Inno Setup 6 后重试,或忽略此目标继续发布 zip。" Condition="'@(IsccExe)' == '' and '$(RequireInstaller)' == 'true'" />
    <Warning Text="找不到 ISCC.exe(Inno Setup 6),跳过安装包生成(仅产出 zip)。可安装后重跑 dotnet publish。" Condition="'@(IsccExe)' == ''" />
    <Delete Files="$(SetupOut)" Condition="Exists('$(SetupOut)')" />
    <Exec Command="&quot;%(IsccExe.Identity)&quot; /Qp /DAppVersion=$(Version) /DSourceRoot=&quot;$(InstallerSourceRoot)&quot; /O&quot;$(MSBuildProjectDirectory)\bin\Package&quot; &quot;$(IssFile)&quot;" Condition="'@(IsccExe)' != ''" />
    <Message Importance="high" Text="安装包已生成: $(SetupOut)" Condition="'@(IsccExe)' != ''" />
  </Target>

</Project>