<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WE_Tool.Info"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WE_Tool"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:uc="using:WE_Tool.Controls"
    xmlns:models="using:WE_Tool.Models"
    NavigationCacheMode="Enabled">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Uid="Info_AboutHeader" FontSize="25" VerticalAlignment="Bottom" Margin="30,0,0,6"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1">
            <StackPanel Margin="25,10,25,0">
                <Grid Margin="0,8,0,0">
                    <InfoBar x:Name="SteamStatusBar" IsOpen="False" IsClosable="False">
                        <InfoBar.ActionButton>
                            <Button x:Name="SteamActionButton" Click="SteamActionButton_Click" Visibility="Collapsed"/>
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <!-- 重试期间覆盖在 InfoBar 顶部的加载条 -->
                    <ProgressBar x:Name="RetryProgressBar" IsIndeterminate="True" Visibility="Collapsed"
                                 VerticalAlignment="Top" HorizontalAlignment="Stretch" Height="3" Margin="8,0"/>
                </Grid>
                <!-- RePKG_Re 后端版本校验 -->
                <InfoBar x:Name="RepkgStatusBar" IsOpen="False" IsClosable="False" Margin="0,8,0,10"/>
                <TextBlock x:Uid="Info_AboutTitle" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,20,0,10"/>
                <controls:SettingsExpander x:Uid="Info_About" Margin="0,0,0,10">
                    <controls:SettingsExpander.HeaderIcon>
                        <!-- 软件图标未定,先用透明 FontIcon 占位 20x20;定稿后替换为真实图标 -->
                        <FontIcon FontSize="20" Width="20" Height="20" Opacity="0"/>
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Content>
                        <TextBlock Text="{x:Bind VersionText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                    </controls:SettingsExpander.Content>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard>
                            <controls:SettingsCard.Header>
                                <StackPanel>
                                    <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="4" Margin="0,0,0,6">
                                        <HyperlinkButton Style="{StaticResource ExternalLinkButtonStyle}" x:Name="GitHubButton" x:Uid="Info_GitHubButton" NavigateUri="https://github.com/ReZe20/WE-Tool"/>
                                        <HyperlinkButton Style="{StaticResource ExternalLinkButtonStyle}" x:Uid="Info_ReleaseNotes" NavigateUri="https://github.com/ReZe20/WE-Tool/releases"/>
                                        <HyperlinkButton x:Uid="Info_LicenseButton" Click="LicenseButton_Click" Margin="8,0,0,0"/>
                                        <HyperlinkButton x:Uid="Info_ThirdPartyButton" Click="ThirdPartyButton_Click" Margin="8,0,0,0"/>
                                    </controls:WrapPanel>
                                    <TextBlock x:Uid="Info_Feedback" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,6"/>
                                    <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="4" Margin="0,0,0,6">
                                        <HyperlinkButton Style="{StaticResource ExternalLinkButtonStyle}" x:Uid="Info_GitHubIssues" NavigateUri="https://github.com/ReZe20/WE-Tool/issues"/>
                                    </controls:WrapPanel>
                                    <TextBlock x:Uid="Info_Credits" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,6"/>
                                    <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="4">
                                        <HyperlinkButton Style="{StaticResource ExternalLinkButtonStyle}" x:Uid="Info_CreditsLine10" NavigateUri="https://github.com/dotnet/csharplang" FontSize="12"/>
                                        <HyperlinkButton Style="{StaticResource ExternalLinkButtonStyle}" x:Uid="Info_CreditsLine1" NavigateUri="https://dotnet.microsoft.com/" FontSize="12"/>
                                        <HyperlinkButton Style="{StaticResource ExternalLinkButtonStyle}" x:Uid="Info_CreditsLine2" NavigateUri="https://github.com/microsoft/WindowsAppSDK" FontSize="12"/>
                                        <HyperlinkButton Style="{StaticResource ExternalLinkButtonStyle}" x:Uid="Info_CreditsLine3" NavigateUri="https://github.com/CommunityToolkit/Windows" FontSize="12"/>
                                        <HyperlinkButton Style="{StaticResource ExternalLinkButtonStyle}" x:Uid="Info_CreditsLine7" NavigateUri="https://github.com/serilog/serilog" FontSize="12"/>
                                        <HyperlinkButton Style="{StaticResource ExternalLinkButtonStyle}" x:Uid="Info_CreditsLine8" NavigateUri="https://github.com/dotMorten/WinUIEx" FontSize="12"/>
                                        <HyperlinkButton Style="{StaticResource ExternalLinkButtonStyle}" x:Uid="Info_CreditsLineSkia" NavigateUri="https://github.com/mono/SkiaSharp" FontSize="12"/>
                                        <HyperlinkButton Style="{StaticResource ExternalLinkButtonStyle}" x:Uid="Info_CreditsLine9" NavigateUri="https://github.com/ReZe20/repkg-Re" FontSize="12"/>
                                        <HyperlinkButton Style="{StaticResource ExternalLinkButtonStyle}" x:Uid="Info_CreditsLine11" NavigateUri="https://github.com/microsoft/Win2D" FontSize="12"/>
                                    </controls:WrapPanel>
                                </StackPanel>
                            </controls:SettingsCard.Header>
                        </controls:SettingsCard>
                        <controls:SettingsCard>
                            <controls:SettingsCard.Header>
                                <StackPanel>
                                    <TextBlock x:Uid="Info_Contributors" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,6"/>
                                    <ItemsControl ItemsSource="{x:Bind Contributors}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:WrapPanel HorizontalSpacing="1" VerticalSpacing="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:Contributor">
                                                <uc:ContributorCard
                                                    AvatarSource="{x:Bind AvatarSource}"
                                                    Badges="{x:Bind Badges}"
                                                    Description="{x:Bind Description}"
                                                    Header="{x:Bind Header}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </controls:SettingsCard.Header>
                        </controls:SettingsCard>
                        <controls:SettingsCard>
                            <controls:SettingsCard.Header>
                                <StackPanel>
                                    <TextBlock x:Uid="Info_TranslationTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,6"/>
                                    <ItemsControl ItemsSource="{x:Bind TranslationStatus}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:TranslationStatusItem">
                                                <!-- 每个语言一张小卡片:主题自适应(Card 资源),圆角 + 细边框 -->
                                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1" CornerRadius="4" Padding="12,4">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{x:Bind PercentText}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </controls:SettingsCard.Header>
                        </controls:SettingsCard>
                        <controls:SettingsCard>
                            <controls:SettingsCard.Header>
                                <StackPanel>
                                    <TextBlock x:Uid="Info_RepkgReferenceDisclaimer" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"/>
                                </StackPanel>
                            </controls:SettingsCard.Header>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <TextBlock x:Uid="Info_RepkgTitle" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,20,0,10"/>
                <controls:SettingsExpander x:Uid="Info_RepkgExpander" Margin="0,0,0,10">
                    <controls:SettingsExpander.HeaderIcon>
                        <!-- repkg 图标未定,同 WE Tool 用透明 FontIcon 占位 20x20;定稿后替换为真实图标 -->
                        <FontIcon FontSize="20" Width="20" Height="20" Opacity="0"/>
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Content>
                        <TextBlock Text="{x:Bind RepkgVersionText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                    </controls:SettingsExpander.Content>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard>
                            <controls:SettingsCard.Header>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <HyperlinkButton Style="{StaticResource ExternalLinkButtonStyle}" x:Uid="Info_RepkgGitHubButton" NavigateUri="https://github.com/ReZe20/repkg-Re"/>
                                        <HyperlinkButton Style="{StaticResource ExternalLinkButtonStyle}" x:Uid="Info_RepkgReleaseNotes" NavigateUri="https://github.com/ReZe20/repkg-Re/releases"/>
                                        <HyperlinkButton x:Uid="Info_RepkgLicenseButton" Click="RepkgLicenseButton_Click" Margin="8,0,0,0"/>
                                        <HyperlinkButton x:Uid="Info_RepkgThirdPartyButton" Click="RepkgThirdPartyButton_Click" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Uid="Info_Feedback" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,6"/>
                                    <HyperlinkButton Style="{StaticResource ExternalLinkButtonStyle}" x:Uid="Info_RepkgIssues" NavigateUri="https://github.com/ReZe20/repkg-Re/issues"/>
                                    <TextBlock x:Uid="Info_Credits" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,6"/>
                                    <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="4">
                                        <HyperlinkButton Style="{StaticResource ExternalLinkButtonStyle}" x:Uid="Info_RepkgCreditsLine6" NavigateUri="https://github.com/dotnet/csharplang" FontSize="12"/>
                                        <HyperlinkButton Style="{StaticResource ExternalLinkButtonStyle}" x:Uid="Info_RepkgCreditsLine1" NavigateUri="https://dotnet.microsoft.com/en-us/download/dotnet-framework" FontSize="12"/>
                                        <HyperlinkButton Style="{StaticResource ExternalLinkButtonStyle}" x:Uid="Info_RepkgCreditsLine2" NavigateUri="https://github.com/commandlineparser/commandline" FontSize="12"/>
                                        <HyperlinkButton Style="{StaticResource ExternalLinkButtonStyle}" x:Uid="Info_RepkgCreditsLine3" NavigateUri="https://github.com/MiloszKrajewski/K4os.Compression.LZ4" FontSize="12"/>
                                        <HyperlinkButton Style="{StaticResource ExternalLinkButtonStyle}" x:Uid="Info_RepkgCreditsLine5" NavigateUri="https://github.com/SixLabors/ImageSharp" FontSize="12"/>
                                    </controls:WrapPanel>
                                </StackPanel>
                            </controls:SettingsCard.Header>
                        </controls:SettingsCard>
                        <controls:SettingsCard>
                            <controls:SettingsCard.Header>
                                <StackPanel>
                                    <TextBlock x:Uid="Info_Contributors" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,6"/>
                                    <ItemsControl ItemsSource="{x:Bind RepkgContributors}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:WrapPanel HorizontalSpacing="1" VerticalSpacing="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:Contributor">
                                                <uc:ContributorCard
                                                    AvatarSource="{x:Bind AvatarSource}"
                                                    Badges="{x:Bind Badges}"
                                                    Description="{x:Bind Description}"
                                                    Header="{x:Bind Header}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </controls:SettingsCard.Header>
                        </controls:SettingsCard>
                        <controls:SettingsCard>
                            <controls:SettingsCard.Header>
                                <StackPanel>
                                    <TextBlock x:Uid="Info_RepkgStory" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"/>
                                    <TextBlock x:Uid="Info_RepkgOriginalRepoLabel" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,8,0,0"/>
                                    <HyperlinkButton Style="{StaticResource ExternalLinkButtonStyle}" x:Uid="Info_RepkgOriginalRepoLink" NavigateUri="https://github.com/notscuffed/repkg" Margin="0,2,0,0"/>
                                </StackPanel>
                            </controls:SettingsCard.Header>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
