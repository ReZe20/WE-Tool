<Page
    x:Class="WE_Tool.Views.Cleanup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WE_Tool.ViewModels"
    x:Name="PageRoot"
    NavigationCacheMode="Enabled">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 + 右上角排序 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock x:Uid="Cleanup_Title" Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock x:Name="SummaryText" FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- 排序按钮 -->
            <DropDownButton x:Name="SortButton" Grid.Column="1"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="排序"
                            Click="SortButton_Click">
                <DropDownButton.Content>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8CB;" FontSize="14"/>
                        <TextBlock x:Name="SortLabelText" Text="排序"/>
                    </StackPanel>
                </DropDownButton.Content>
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="SortMenu" Placement="BottomEdgeAlignedRight" Opened="FlyoutThemeRefresh_Opened">
                        <RadioMenuFlyoutItem x:Name="SortByNameItem" GroupName="CleanupSortGroup"
                                             Text="名称" Click="SortMenu_ItemClick" Tag="name"/>
                        <RadioMenuFlyoutItem x:Name="SortByTypeItem" GroupName="CleanupSortGroup"
                                             Text="类型" Click="SortMenu_ItemClick" Tag="type"/>
                        <RadioMenuFlyoutItem x:Name="SortBySizeItem" GroupName="CleanupSortGroup"
                                             Text="大小" Click="SortMenu_ItemClick" Tag="size"/>
                        <MenuFlyoutSeparator/>
                        <ToggleMenuFlyoutItem x:Name="SortDescendingItem" Text="降序"
                                              Click="SortDescendingItem_Click"/>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <!-- 空状态(自动扫描,失败/完成时显示提示) -->
        <StackPanel x:Name="EmptyState" Grid.Row="1"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
            <TextBlock x:Name="EmptyStateText" FontSize="16"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextAlignment="Center"/>
        </StackPanel>

        <!-- 扫描进度 -->
        <ProgressRing x:Name="ScanProgress" Grid.Row="1" IsActive="False"
                      Width="48" Height="48" VerticalAlignment="Center" HorizontalAlignment="Center"/>

        <!-- 结果卡片网格 -->
        <GridView x:Name="ResultGridView" Grid.Row="1"
                  Visibility="Collapsed"
                  SelectionMode="None"
                  SizeChanged="ResultGridView_SizeChanged">
            <GridView.ItemContainerTransitions>
                <TransitionCollection>
                    <!-- 重排时从旧位置平移到新位置(resize 列宽变化带动画) -->
                    <RepositionThemeTransition/>
                    <!-- 卡片加入/移除淡入淡出 -->
                    <AddDeleteThemeTransition/>
                </TransitionCollection>
            </GridView.ItemContainerTransitions>
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="5"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal"
                                   ItemHeight="300" ItemWidth="300"/>
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:CleanupCardViewModel">
                    <Border CornerRadius="8"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            Padding="14">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 标题行:壁纸ID + 类型标签 -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind FolderId}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind FullPath}"/>
                                <Border Grid.Column="1" CornerRadius="4"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                                    <TextBlock Text="{x:Bind TypeLabel}" FontSize="11"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Margin="6,2"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <!-- 统计 -->
                            <TextBlock Grid.Row="1" Text="{x:Bind StatsText}" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                            <!-- 文件列表(卡片内滚动显示全部) -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{x:Bind Files}" Margin="0,0,10,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:CleanupFileItem">
                                            <Grid ColumnSpacing="8" Padding="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Name}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTipService.ToolTip="{x:Bind Name}"/>
                                                <TextBlock Grid.Column="1" Text="{x:Bind SizeText}"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- 底部行:左边 CheckBox + 右边操作按钮 -->
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox MinWidth="0"
                                          VerticalAlignment="Center"
                                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                          Click="SelectCheckBox_Click"
                                          Tag="{x:Bind}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            HorizontalAlignment="Right" Spacing="8">
                                    <Button x:Uid="Cleanup_OpenFolder" Click="OpenFolder_Click"
                                            CommandParameter="{x:Bind}"/>
                                    <Button x:Uid="Cleanup_Whitelist" Click="WhitelistCard_Click"
                                            CommandParameter="{x:Bind}"/>
                                    <Button x:Uid="Cleanup_Delete" Click="CleanCard_Click"
                                            CommandParameter="{x:Bind}"
                                            Style="{StaticResource AccentButtonStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- 底部 CommandBar: 重新扫描 + 清理全部 -->
        <CommandBar x:Name="ActionBar" Grid.Row="2"
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    DefaultLabelPosition="Right"
                    Visibility="Collapsed">
            <CommandBar.PrimaryCommands>
                <!-- 多选操作(选中时显示) -->
                <AppBarButton x:Name="BatchWhitelistButton" x:Uid="Cleanup_BatchWhitelist" Click="BatchWhitelist_Click" IsEnabled="False">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE72E;"/></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="BatchDeleteButton" x:Uid="Cleanup_BatchDelete" Click="BatchDelete_Click" IsEnabled="False" Foreground="Red">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE74D;"/>
                    </AppBarButton.Icon>
                </AppBarButton>
                <!-- 常规操作 -->
                <AppBarButton x:Uid="Cleanup_WhitelistManage" Click="WhitelistButton_Click">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE72E;"/>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Uid="Cleanup_Rescan" Click="ScanButton_Click">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE72C;"/>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Uid="Cleanup_DeleteAll" Click="DeleteAllButton_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74D;"/></AppBarButton.Icon>
                </AppBarButton>
            </CommandBar.PrimaryCommands>
        </CommandBar>
    </Grid>
</Page>
