<Page
    x:Class="WE_Tool.Views.WallpaperBackup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WE_Tool.ViewModels"
    xmlns:skia="using:WE_Tool.Controls"
    x:Name="PageRoot"
    NavigationCacheMode="Enabled">

        <Page.Resources>
        <!-- 自动备份设置 Flyout：类型/分级用 Expander 分组 -->
        <Flyout x:Name="AutoBackupFlyout">
            <Flyout.FlyoutPresenterStyle>
                <Style TargetType="FlyoutPresenter">
                    <Setter Property="CornerRadius" Value="8"/>
                    <Setter Property="MaxWidth" Value="480"/>
                    <Setter Property="MaxHeight" Value="560"/>
                    <Setter Property="Padding" Value="0"/>
                </Style>
            </Flyout.FlyoutPresenterStyle>
            <StackPanel Spacing="0" Padding="16,12">

                <!-- 方式选择 -->
                <StackPanel Spacing="6" Padding="0,0,0,12">
                    <TextBlock x:Uid="AutoBackup_ModeLabel" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <RadioButton x:Name="ModeOffRadio" GroupName="AutoBackupMode"
                                     x:Uid="AutoBackup_ModeOff" Checked="Mode_Checked"/>
                        <RadioButton x:Name="ModeServiceRadio" GroupName="AutoBackupMode"
                                     x:Uid="AutoBackup_ModeService" Checked="Mode_Checked"/>
                        <RadioButton x:Name="ModeOnStartupRadio" GroupName="AutoBackupMode"
                                     x:Uid="AutoBackup_ModeOnStartup" Checked="Mode_Checked"/>
                    </StackPanel>
                </StackPanel>

                <!-- 服务管理 -->
                <StackPanel x:Name="ServicePanel" Spacing="6" Padding="0,0,0,12">
                    <TextBlock x:Uid="AutoBackup_ServiceStatusLabel"
                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <TextBlock x:Name="ServiceStatusText" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="InstallServiceButton" x:Uid="AutoBackup_Install"
                                Click="ServiceAction_Click" Tag="install"
                                Style="{StaticResource AccentButtonStyle}"/>
                        <Button x:Name="UninstallServiceButton" x:Uid="AutoBackup_Uninstall"
                                Click="ServiceAction_Click" Tag="uninstall" IsEnabled="False"/>
                        <Button x:Name="StartServiceButton" x:Uid="AutoBackup_Start"
                                Click="ServiceAction_Click" Tag="start" IsEnabled="False"/>
                        <Button x:Name="StopServiceButton" x:Uid="AutoBackup_Stop"
                                Click="ServiceAction_Click" Tag="stop" IsEnabled="False"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="自动备份以下壁纸" Margin="0,0,0,8"/>
                <!-- 类型筛选 Expander -->
                <Expander x:Name="TypeExpander" HorizontalAlignment="Stretch"
                          CornerRadius="4" Margin="0,0,0,8">
                    <Expander.Header>
                        <TextBlock x:Uid="AutoBackup_TypeLabel"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Padding="0,4"/>
                    </Expander.Header>
                    <StackPanel Margin="4,8,4,4">
                        <CheckBox x:Name="TypeSceneCheck" x:Uid="AutoBackup_TypeScene"
                                  Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                        <CheckBox x:Name="TypeVideoCheck" x:Uid="AutoBackup_TypeVideo"
                                  Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                        <CheckBox x:Name="TypeWebCheck" x:Uid="AutoBackup_TypeWeb"
                                  Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                        <CheckBox x:Name="TypeAppCheck" x:Uid="AutoBackup_TypeApp"
                                  Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                        <CheckBox x:Name="TypePresetCheck" x:Uid="AutoBackup_TypePreset"
                                  Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                        <CheckBox x:Name="TypeUnknownCheck" x:Uid="AutoBackup_TypeUnknown"
                                  Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                    </StackPanel>
                </Expander>

                <!-- 分级筛选 Expander -->
                <Expander x:Name="RatingExpander" HorizontalAlignment="Stretch"
                          CornerRadius="4">
                    <Expander.Header>
                        <TextBlock x:Uid="AutoBackup_RatingLabel"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Padding="0,4"/>
                    </Expander.Header>
                    <StackPanel Margin="4,8,4,4">
                        <CheckBox x:Name="RatingGCheck" x:Uid="AutoBackup_RatingG"
                                  Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                        <CheckBox x:Name="RatingPgCheck" x:Uid="AutoBackup_RatingPg"
                                  Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                        <CheckBox x:Name="RatingRCheck" x:Uid="AutoBackup_RatingR"
                                  Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                    </StackPanel>
                </Expander>

            </StackPanel>
        </Flyout>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock x:Uid="BackupPage_Title" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock x:Name="SummaryText" FontSize="14"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- 空状态 -->
        <StackPanel x:Name="EmptyState" Grid.Row="1"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
            <TextBlock x:Name="EmptyStateText" FontSize="16"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextAlignment="Center"/>
        </StackPanel>

        <!-- 扫描进度 -->
        <ProgressRing x:Name="ScanProgress" Grid.Row="1" IsActive="False"
                      Width="48" Height="48" VerticalAlignment="Center" HorizontalAlignment="Center"/>

        <!-- 备份卡片网格 -->
        <GridView x:Name="BackupGridView" Grid.Row="1" Visibility="Collapsed"
                  SelectionMode="None" SizeChanged="BackupGridView_SizeChanged"
                  ContainerContentChanging="BackupGridView_ContainerContentChanging">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid x:Name="BackupWrapGrid" Orientation="Horizontal"
                                   CacheLength="0"/>
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="5"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:BackupItemViewModel">
                    <Grid Height="140" Padding="12" CornerRadius="8"
                          HorizontalAlignment="Stretch"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- 源已删除角标:取消订阅/下架后仅剩备份时显示(跨全列,右上角) -->
                        <Border x:Name="SourceMissingBadge"
                                Grid.ColumnSpan="3"
                                Background="#E8A33D" CornerRadius="8" Padding="8,3"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,-2,-2,0"
                                Visibility="{x:Bind SourceMissingVisibility, Mode=OneWay}">
                            <TextBlock x:Uid="BackupPage_SourceMissing" FontSize="11"
                                       Foreground="Black" FontWeight="SemiBold"/>
                        </Border>
                        <Grid Grid.Column="0" Width="100" Height="100">
                            <!-- 与 Papers 一致:BitmapImage.UriSource 驱动;无预览图时用占位图(非 null/空串) -->
                            <Image x:Name="PreviewImage" Stretch="UniformToFill"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image.Source>
                                    <BitmapImage UriSource="{x:Bind PreviewPath, Mode=OneWay}"/>
                                </Image.Source>
                            </Image>
                            <!-- GIF 动图用 Skia 流式播放(与 Papers 一致),隐藏静态 Image -->
                            <skia:SkiaGifView x:Name="PreviewSkiaGif" Visibility="Collapsed"
                                              Width="100" Height="100"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0"
                                    VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                       FontSize="16" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" MaxLines="2"/>
                            <TextBlock Text="{x:Bind WorkshopId, Mode=OneWay}"
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind SizeText, Mode=OneWay}"
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind BackupTimeText, Mode=OneWay}"
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="2" VerticalAlignment="Center"
                                CommandParameter="{x:Bind}"
                                Click="DeleteBackup_Click"
                                Background="Transparent"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <FontIcon Glyph="&#xE74D;" FontSize="16"/>
                        </Button>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- 底部操作栏 -->
        <CommandBar Grid.Row="2" DefaultLabelPosition="Right">
            <!-- 自动备份设置按钮（最左） -->
            <AppBarButton x:Name="AutoBackupButton" x:Uid="AutoBackup_SettingsButton"
                          Click="AutoBackupButton_Click">
                <AppBarButton.Icon><FontIcon Glyph="&#xE74E;"/></AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator/>
            <AppBarButton x:Name="RefreshButton" x:Uid="BackupPage_Refresh"
                          Click="ScanButton_Click">
                <AppBarButton.Icon><FontIcon Glyph="&#xE777;"/></AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator/>
            <AppBarButton x:Name="DeleteAllButton" x:Uid="BackupPage_DeleteAll"
                          Click="DeleteAll_Click">
                <AppBarButton.Icon><FontIcon Glyph="&#xE74D;"/></AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>
    </Grid>
</Page>
