<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WE_Tool.Papers"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WE_Tool"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WE_Tool.Models"
    xmlns:loc="using:WE_Tool.Helper"
    xmlns:converters="using:WE_Tool.Converters"
    mc:Ignorable="d"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:wetool="using:WE_Tool.Controls"
    xmlns:skia="using:WE_Tool.Controls"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    x:Name="PageRoot"
    KeyDown="Page_KeyDown"
    NavigationCacheMode="Enabled"
    xmlns:animatedvisuals="using:WE_Tool.AnimatedVisuals">
    <Page.Resources>
        <converters:FileSizeToString x:Key="FileSizeToString"/>
        <converters:TypeToDisplay x:Key="TypeToDisplay"/>
        <converters:SourceToDisplay x:Key="SourceToDisplay"/>
        <converters:RatingToDisplay x:Key="RatingToDisplay"/>
        <converters:TagToDisplay x:Key="TagToDisplay"/>
        <converters:DescriptionToDisplay x:Key="DescriptionToDisplay"/>
        <converters:DateTimeToString x:Key="DateTimeToString"/>
        <converters:PapersTagContentChoose x:Key="PapersTagContentChoose"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <Style x:Key="TransparentGridViewItemStyle" TargetType="GridViewItem">
            <Setter Property="Margin" Value="5,5,5,5"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <!-- 去掉 GridViewItem 默认悬停/选中/焦点视觉(卡片自带悬停阴影,与 ItemsRepeater 观感一致) -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewItem">
                        <ContentPresenter HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <CommandBarFlyout x:Name="WallpaperContextMenu" AlwaysExpanded="True" Opened="FlyoutThemeRefresh_Opened">
            <CommandBarFlyout.PrimaryCommands>
                <AppBarButton x:Uid="AppBarButton_Extract"
                              Command="{x:Bind ExtractSelectedCommand}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE72D;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator/>
                <AppBarButton x:Uid="AppBarButton_OpenDirectory"
                              Command="{x:Bind OpenSelectedFoldersCommand}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE838;"/>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator/>
                <AppBarButton x:Uid="AppBarButton_Uninstall"
                              Command="{x:Bind UninstallSelectedCommand}"
                              Click="UninstallIcon_Click"
                              IsEnabled="{x:Bind IsUninstallEnabled, Mode=OneWay}"
                              KeyboardAcceleratorTextOverride="     Delete">
                    <AppBarButton.Icon>
                        <wetool:ThemedAnimatedIcon AnimatedIcon.State="Normal" Width="16" Height="16">
                            <wetool:ThemedAnimatedIcon.Source>
                                <animatedvisuals:DeleteIcon/>
                            </wetool:ThemedAnimatedIcon.Source>
                            <wetool:ThemedAnimatedIcon.FallbackIconSource>
                                <FontIconSource Glyph="&#xE74D;"/>
                            </wetool:ThemedAnimatedIcon.FallbackIconSource>
                        </wetool:ThemedAnimatedIcon>
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBarFlyout.PrimaryCommands>
            <CommandBarFlyout.SecondaryCommands>
                <AppBarButton x:Uid="AppBarButton_Copy" 
                              Click="Copy_Click_ByCommandBarFlyout"
                              KeyboardAcceleratorTextOverride="     Ctrl+C">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE8C8;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="BackupWallpaperButton"
                              x:Uid="AppBarButton_Backup">
                    <AppBarButton.Icon>
                        <!-- [2026-09-21] 换成壁纸备份页在导航栏那一枚的 Lottie(原静态字形 E7B8 留作回退) -->
                        <wetool:ThemedAnimatedIcon AnimatedIcon.State="Normal" Width="16" Height="16">
                            <wetool:ThemedAnimatedIcon.Source>
                                <animatedvisuals:WallpaperBackupIcon/>
                            </wetool:ThemedAnimatedIcon.Source>
                            <wetool:ThemedAnimatedIcon.FallbackIconSource>
                                <FontIconSource Glyph="&#xE7B8;"/>
                            </wetool:ThemedAnimatedIcon.FallbackIconSource>
                        </wetool:ThemedAnimatedIcon>
                    </AppBarButton.Icon>
                    <!-- [备份/取消备份 2026-09] 子菜单:两条命令各自带数量与可用性(混合选中时两条都可用);
                         父按钮不再直接执行动作(原 Click 拆到两条命令),避免"混合态只能表达一半" -->
                    <AppBarButton.Flyout>
                        <MenuFlyout x:Name="BackupSubMenu" Opening="BackupSubMenu_Opening">
                            <MenuFlyoutItem x:Name="BackupSelectedMenuItem"
                                            x:Uid="MenuFlyoutItem_BackupSelected"
                                            Click="BackupSelected_Click"/>
                            <MenuFlyoutItem x:Name="UnbackupSelectedMenuItem"
                                            x:Uid="MenuFlyoutItem_UnbackupSelected"
                                            Click="UnbackupSelected_Click"/>
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarSeparator/>
                <AppBarButton x:Uid="AppBarButton_ImportToEditor"
                              Click="ImportToEditor_Click"
                              IsEnabled="{x:Bind IsImportToEditorEnabled, Mode=OneWay}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE70F;"/>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="ConvertToMobileButton"
                              x:Uid="AppBarButton_ConvertToMobile"
                              Click="ConvertToMobile_Click"
                              IsEnabled="{x:Bind IsConvertToMobileEnabled, Mode=OneWay}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE8EA;"/>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator/>
                <AppBarButton x:Uid="AppBarButton_SelectAll" 
                              Click="SelectAllWallpapers_Click_ByCommandBarFlyout"
                              KeyboardAcceleratorTextOverride="     Ctrl+A">
                    <AppBarButton.Icon>
                        <wetool:ThemedAnimatedIcon AnimatedIcon.State="Normal" Width="16" Height="16">
                            <wetool:ThemedAnimatedIcon.Source>
                                <animatedvisuals:SelectAllIcon/>
                            </wetool:ThemedAnimatedIcon.Source>
                            <wetool:ThemedAnimatedIcon.FallbackIconSource>
                                <FontIconSource Glyph="&#xE8B3;"/>
                            </wetool:ThemedAnimatedIcon.FallbackIconSource>
                        </wetool:ThemedAnimatedIcon>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Uid="AppBarButton_InvertSelection" 
                              Click="InvertSelection_CLick_ByCommandBarFlyout"
                              KeyboardAcceleratorTextOverride="     Ctrl+I">
                    <AppBarButton.Icon>
                        <wetool:ThemedAnimatedIcon AnimatedIcon.State="Normal" Width="16" Height="16">
                            <wetool:ThemedAnimatedIcon.Source>
                                <animatedvisuals:InvertSelection/>
                            </wetool:ThemedAnimatedIcon.Source>
                            <wetool:ThemedAnimatedIcon.FallbackIconSource>
                                <FontIconSource Glyph="&#xE8E6;"/>
                            </wetool:ThemedAnimatedIcon.FallbackIconSource>
                        </wetool:ThemedAnimatedIcon>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator/>
                <AppBarButton x:Uid="AppBarButton_Properties" 
                              Click="Properties_Click_ByCommandBarFlyout"
                              KeyboardAcceleratorTextOverride="     Ctrl+E">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE90F;"/>
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBarFlyout.SecondaryCommands>
        </CommandBarFlyout>
        
        <!-- [详情面板确认弹层 2026-09-21] 取代"确认对话框 + 结果对话框"两次点击:在按钮处弹这层小卡,
             一句提示 + 确定/取消(Esc 或点别处也算放弃)。提示与按钮文案都在代码里按 LanguageHelper 设,
             不走 x:Uid(TextBlock 用 .Text、Button 用 .Content,两套键名在弹层里容易踩空)。
             Opened 仍挂 FlyoutThemeRefresh_Opened:弹层内容在独立顶层里,不继承页面主题(App.ApplyFlyoutTheme 支持 Flyout)。 -->
        <Flyout x:Name="UnbackupConfirmFlyout" Opened="FlyoutThemeRefresh_Opened">
            <StackPanel Width="300" Spacing="10">
                <TextBlock x:Name="UnbackupFlyoutHint" TextWrapping="Wrap" FontSize="12"/>
                <TextBlock x:Name="UnbackupFlyoutWarn" TextWrapping="Wrap" FontSize="12"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button x:Name="UnbackupFlyoutConfirmButton" Style="{StaticResource AccentButtonStyle}"
                            Click="UnbackupConfirm_Click"/>
                    <Button x:Name="UnbackupFlyoutCancelButton" Click="FlyoutDismiss_Click"/>
                </StackPanel>
            </StackPanel>
        </Flyout>
        <Flyout x:Name="UninstallConfirmFlyout" Opened="FlyoutThemeRefresh_Opened">
            <StackPanel Width="300" Spacing="10">
                <TextBlock x:Name="UninstallFlyoutHint" TextWrapping="Wrap" FontSize="12"/>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button x:Name="UninstallFlyoutConfirmButton" Style="{StaticResource AccentButtonStyle}"
                            Click="UninstallConfirm_Click"/>
                    <Button x:Name="UninstallFlyoutCancelButton" Click="FlyoutDismiss_Click"/>
                </StackPanel>
            </StackPanel>
        </Flyout>

        <MenuFlyout x:Name="ScrollViewBackgroundMenu" Opened="FlyoutThemeRefresh_Opened">
            <MenuFlyoutItem x:Uid="MenuFlyoutItem_Refresh" 
                            Click="WallpaperListRefresh_Click_ByCommandBarFlyout"
                            KeyboardAcceleratorTextOverride="    F5">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE777;"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem x:Uid="MenuFlyoutItem_SelectAll" 
                            Click="SelectAllWallpapers_Click_ByCommandBarFlyout"
                            KeyboardAcceleratorTextOverride="    Ctrl+A">
                <MenuFlyoutItem.Icon>
                    <wetool:ThemedAnimatedIcon AnimatedIcon.State="Normal" Width="16" Height="16">
                        <wetool:ThemedAnimatedIcon.Source>
                            <animatedvisuals:SelectAllIcon/>
                        </wetool:ThemedAnimatedIcon.Source>
                        <wetool:ThemedAnimatedIcon.FallbackIconSource>
                            <FontIconSource Glyph="&#xE8B3;"/>
                        </wetool:ThemedAnimatedIcon.FallbackIconSource>
                    </wetool:ThemedAnimatedIcon>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Uid="MenuFlyoutItem_InvertSelection"
                            Click="InvertSelection_CLick_ByCommandBarFlyout"
                            KeyboardAcceleratorTextOverride="    Ctrl+I">
                <MenuFlyoutItem.Icon>
                    <wetool:ThemedAnimatedIcon AnimatedIcon.State="Normal" Width="16" Height="16">
                        <wetool:ThemedAnimatedIcon.Source>
                            <animatedvisuals:InvertSelection/>
                        </wetool:ThemedAnimatedIcon.Source>
                        <wetool:ThemedAnimatedIcon.FallbackIconSource>
                            <FontIconSource Glyph="&#xE8E6;"/>
                        </wetool:ThemedAnimatedIcon.FallbackIconSource>
                    </wetool:ThemedAnimatedIcon>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator/>
            <MenuFlyoutSubItem x:Uid="MenuFlyoutSubItem_View">
                <MenuFlyoutSubItem.Icon>
                    <FontIcon Glyph="&#xE71D;"/>
                </MenuFlyoutSubItem.Icon>
                <RadioMenuFlyoutItem x:Uid="AppBarButton_SmallIcon" 
                                     IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.SmallIconViewItem,Mode=TwoWay}"
                                     GroupName="MenuViewGroup"/>
                <RadioMenuFlyoutItem x:Uid="AppBarButton_MediumIcon"
                                     IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.MediumIconViewItem,Mode=TwoWay}"
                                     GroupName="MenuViewGroup"/>
                <RadioMenuFlyoutItem x:Uid="AppBarButton_LargeIcon"
                                     IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.LargeIconViewItem,Mode=TwoWay}"
                                     GroupName="MenuViewGroup"/>
                <RadioMenuFlyoutItem x:Uid="AppBarButton_ContentMode"
                                     IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.ContentViewItem,Mode=TwoWay}"
                                     GroupName="MenuViewGroup"/>
                <RadioMenuFlyoutItem x:Uid="AppBarButton_ListMode"
                                     IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.ListViewItem,Mode=TwoWay}"
                                     GroupName="MenuViewGroup"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutSubItem x:Uid="MenuFlyoutSubItem_TagDisplay">
                    <RadioMenuFlyoutItem GroupName="MenuLabelGroup"
                                         x:Uid="AppBarButton_Type"
                                         Click="OnTagDisplayChanged"
                                         IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.TypeDisplayInTag, Mode=TwoWay}"/>
                    <RadioMenuFlyoutItem GroupName="MenuLabelGroup"
                                         x:Uid="AppBarButton_Rating"
                                         Click="OnTagDisplayChanged"
                                         IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.RatingDisplayInTag, Mode=TwoWay}"/>
                    <RadioMenuFlyoutItem GroupName="MenuLabelGroup"
                                         x:Uid="AppBarButton_Source"
                                         Click="OnTagDisplayChanged"
                                         IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.SourceDisplayInTag, Mode=TwoWay}"/>
                    <RadioMenuFlyoutItem GroupName="MenuLabelGroup"
                                         x:Uid="AppBarButton_Tag"
                                         Click="OnTagDisplayChanged"
                                         IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.TagDisplayInTag, Mode=TwoWay}"/>
                    <RadioMenuFlyoutItem GroupName="MenuLabelGroup"
                                         x:Uid="AppBarButton_None"
                                         Click="OnTagDisplayChanged"
                                         IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.NoneDisplayInTag, Mode=TwoWay}"/>
                </MenuFlyoutSubItem>
                <!-- 预览模糊:与顶部"查看"菜单同一份开关(BlurEveryone/Teen/Adult) -->
                <MenuFlyoutSubItem x:Uid="MenuFlyoutSubItem_PreviewBlur">
                    <ToggleMenuFlyoutItem x:Uid="Blur_Everyone"
                                         IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.BlurEveryone, Mode=TwoWay}"/>
                    <ToggleMenuFlyoutItem x:Uid="Blur_Teen"
                                         IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.BlurTeen, Mode=TwoWay}"/>
                    <ToggleMenuFlyoutItem x:Uid="Blur_Adult"
                                         IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.BlurAdult, Mode=TwoWay}"/>
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem x:Uid="Pagination">
                        <RadioMenuFlyoutItem GroupName="MenuPageSizeGroup" x:Uid="Pagination_None"
                                             IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.NoPaginationItem, Mode=TwoWay}"/>
                        <RadioMenuFlyoutItem GroupName="MenuPageSizeGroup" x:Uid="Pagination_30"
                                             IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.PageSize30Item, Mode=TwoWay}"/>
                        <RadioMenuFlyoutItem GroupName="MenuPageSizeGroup" x:Uid="Pagination_50"
                                             IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.PageSize50Item, Mode=TwoWay}"/>
                        <RadioMenuFlyoutItem GroupName="MenuPageSizeGroup" x:Uid="Pagination_70"
                                             IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.PageSize70Item, Mode=TwoWay}"/>
                        <RadioMenuFlyoutItem GroupName="MenuPageSizeGroup" x:Uid="Pagination_90"
                                             IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.PageSize90Item, Mode=TwoWay}"/>
                    </MenuFlyoutSubItem>
                </MenuFlyoutSubItem>
                <!-- 排序已在查看菜单内置标签，此处仅保留排序 -->
            <MenuFlyoutSubItem x:Uid="MenuFlyoutSubItem_Sort">
                <MenuFlyoutSubItem.Icon>
                    <FontIcon Glyph="&#xE8CB;"/>
                </MenuFlyoutSubItem.Icon>
                <RadioMenuFlyoutItem x:Uid="SortByName"
                                     Command="{x:Bind ViewModel.WallpaperDisplayVM.ChangeSortCommand}" CommandParameter="0"
                                     Click="ChangeSort"
                                     IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.SortByName,Mode=TwoWay}"
                                     GroupName="MenuSortGroup"/>
                <RadioMenuFlyoutItem x:Uid="SortBySubTime"
                                     Command="{x:Bind ViewModel.WallpaperDisplayVM.ChangeSortCommand}" CommandParameter="1"
                                     Click="ChangeSort"
                                     IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.SortBySubTime,Mode=TwoWay}"
                                     GroupName="MenuSortGroup"/>
                <RadioMenuFlyoutItem x:Uid="SortByLastTime"
                                     Command="{x:Bind ViewModel.WallpaperDisplayVM.ChangeSortCommand}" CommandParameter="2"
                                     Click="ChangeSort"
                                     IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.SortByLastTime,Mode=TwoWay}"
                                     GroupName="MenuSortGroup"/>
                <RadioMenuFlyoutItem x:Uid="SortByAcfUpdateTime"
                                     Command="{x:Bind ViewModel.WallpaperDisplayVM.ChangeSortCommand}" CommandParameter="4"
                                     Click="ChangeSort"
                                     IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.SortByAcfUpdateTime,Mode=TwoWay}"
                                     GroupName="MenuSortGroup"/>
                <RadioMenuFlyoutItem x:Uid="SortByFileSize"
                                     Command="{x:Bind ViewModel.WallpaperDisplayVM.ChangeSortCommand}" CommandParameter="3"
                                     Click="ChangeSort"
                                     IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.SortByFileSize,Mode=TwoWay}"
                                     GroupName="MenuSortGroup"/>
                <MenuFlyoutSeparator/>
                <!-- 排序方向:与工具栏 SortDirectionButton 同一份状态(IsSortAscending),两条入口互相跟着变 -->
                <RadioMenuFlyoutItem x:Uid="SortDirection_Increase"
                                     IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.IsSortAscending,Mode=TwoWay}"
                                     GroupName="MenuSortDirectionGroup"/>
                <RadioMenuFlyoutItem x:Uid="SortDirection_Decrease"
                                     IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.IsSortDescending,Mode=TwoWay}"
                                     GroupName="MenuSortDirectionGroup"/>
            </MenuFlyoutSubItem>
        </MenuFlyout>
        <MenuFlyout x:Key="FilterExpanderContextMenu" Opening="FilterExpanderContextMenu_Opening">
            <MenuFlyoutItem x:Uid="MenuFlyoutItem_SelectAll" Click="FilterExpanderSelectAll_Click">
                <MenuFlyoutItem.Icon>
                    <wetool:ThemedAnimatedIcon AnimatedIcon.State="Normal" Width="16" Height="16">
                        <wetool:ThemedAnimatedIcon.Source>
                            <animatedvisuals:SelectAllIcon/>
                        </wetool:ThemedAnimatedIcon.Source>
                        <wetool:ThemedAnimatedIcon.FallbackIconSource>
                            <FontIconSource Glyph="&#xE8B3;"/>
                        </wetool:ThemedAnimatedIcon.FallbackIconSource>
                    </wetool:ThemedAnimatedIcon>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Uid="MenuFlyoutItem_InvertSelection" Click="FilterExpanderInvert_Click">
                <MenuFlyoutItem.Icon>
                    <wetool:ThemedAnimatedIcon AnimatedIcon.State="Normal" Width="16" Height="16">
                        <wetool:ThemedAnimatedIcon.Source>
                            <animatedvisuals:InvertSelection/>
                        </wetool:ThemedAnimatedIcon.Source>
                        <wetool:ThemedAnimatedIcon.FallbackIconSource>
                            <FontIconSource Glyph="&#xE8E6;"/>
                        </wetool:ThemedAnimatedIcon.FallbackIconSource>
                    </wetool:ThemedAnimatedIcon>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>
    <Page.KeyboardAccelerators>
        <!-- 已迁移到 Page.KeyDown（Page_KeyDown）：KeyboardAccelerator 在部分焦点/输入法环境下 Ctrl+I 等组合键不触发 -->
    </Page.KeyboardAccelerators>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="{x:Bind ViewModel.WallpaperDisplayVM.BottomBarHeight, Mode=OneWay}"/>
        </Grid.RowDefinitions>
        <!-- Row 0: 工具栏 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- 底部装饰线（全宽） -->
            <Rectangle Grid.ColumnSpan="3" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="1" Fill="{ThemeResource DividerStrokeColorDefault}"/>
            <!-- 左侧：搜索框 -->
            <AutoSuggestBox x:Name="WallpaperSearchBox"
                            Height="37"
                            Width="208"
                            QueryIcon="Find"
                            x:Uid="SearchBox"
                            HorizontalAlignment="Left"
                            Margin="3,3,0,0"
                            FontSize="16"
                            CornerRadius="6"
                            FontWeight="Light"
                            VerticalAlignment="Top"
                            TextMemberPath="Text"
                            DisplayMemberPath="Display"
                            TextChanged="WallpaperSearchBox_TextChanged"/>
            <!-- 中间：CommandBar（* 列，受限于窗口宽度） -->
            <CommandBar Grid.Column="1" x:Name="ToolbarCommands"
                        VerticalAlignment="Bottom"
                        Background="Transparent"
                        DefaultLabelPosition="Right"
                        IsDynamicOverflowEnabled="True"
                        OverflowButtonVisibility="Auto"
                        HorizontalAlignment="Left">
                <AppBarToggleButton x:Name="LeftToggleFilterButton"
                                    x:Uid="Toolbar_FilterToggle"
                                    IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.LeftSplitViewPaneOpen, Mode=TwoWay}">
                    <AppBarToggleButton.Icon>
                        <!-- 筛选结果图标:按下/松开两段播的 Lottie(与视图按钮同一素材 ViewIcon),E71D 回退;接线见 Papers.xaml.cs“筛选结果图标动画”区块;TrustForeground 让选中态与文字同色(黑/白反相) -->
                        <wetool:ThemedAnimatedIcon x:Name="LeftToggleFilterIcon" AnimatedIcon.State="Normal" Width="16" Height="16" TrustForeground="True">
                            <wetool:ThemedAnimatedIcon.Source>
                                <animatedvisuals:ViewIcon/>
                            </wetool:ThemedAnimatedIcon.Source>
                            <wetool:ThemedAnimatedIcon.FallbackIconSource>
                                <FontIconSource Glyph="&#xE71D;"/>
                            </wetool:ThemedAnimatedIcon.FallbackIconSource>
                        </wetool:ThemedAnimatedIcon>
                    </AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarSeparator/>
                <AppBarButton x:Name="ToolbarCopyButton" x:Uid="Toolbar_CopyButton"
                              IsEnabled="{x:Bind ViewModel.IsButtonInGridColumnEnabled, Mode=OneWay}"
                              Click="Copy_Click_ByCommandBarFlyout"
                              LabelPosition="Collapsed">
                    <AppBarButton.Icon>
                        <!-- 复制图标:按下/松开两段播的是这份 Lottie(与详情面板复制同一素材);勾动画由代码换入的 FontIcon 承载
                             —— AppBarButton 图标槽只放得下一个元素(模板里是 Viewbox 包 ContentPresenter 绑 Icon),
                             播完换回 Lottie 并归零。见 Papers.xaml.cs“工具栏复制图标”区块 -->
                        <wetool:ThemedAnimatedIcon x:Name="ToolbarCopyIcon" AnimatedIcon.State="Normal" Width="16" Height="16">
                            <wetool:ThemedAnimatedIcon.Source>
                                <animatedvisuals:CopyIcon/>
                            </wetool:ThemedAnimatedIcon.Source>
                            <wetool:ThemedAnimatedIcon.FallbackIconSource>
                                <FontIconSource Glyph="&#xE8C8;"/>
                            </wetool:ThemedAnimatedIcon.FallbackIconSource>
                        </wetool:ThemedAnimatedIcon>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Uid="Toolbar_Uninstall"
                              IsEnabled="{x:Bind ViewModel.IsButtonInGridColumnEnabled, Mode=OneWay}"
                              Command="{x:Bind UninstallSelectedCommand}"
                              Click="UninstallIcon_Click"
                              LabelPosition="Collapsed">
                    <AppBarButton.Icon>
                        <wetool:ThemedAnimatedIcon AnimatedIcon.State="Normal" Width="16" Height="16">
                            <wetool:ThemedAnimatedIcon.Source>
                                <animatedvisuals:DeleteIcon/>
                            </wetool:ThemedAnimatedIcon.Source>
                            <wetool:ThemedAnimatedIcon.FallbackIconSource>
                                <FontIconSource Glyph="&#xE74D;"/>
                            </wetool:ThemedAnimatedIcon.FallbackIconSource>
                        </wetool:ThemedAnimatedIcon>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="ToolbarSelectAllButton" x:Uid="Toolbar_SelectAll"
                              Click="SelectAllWallpapers_Click_ByCommandBarFlyout"
                              LabelPosition="Collapsed">
                    <AppBarButton.Icon>
                        <wetool:ThemedAnimatedIcon x:Name="ToolbarSelectAllIcon" AnimatedIcon.State="Normal" Width="16" Height="16">
                            <wetool:ThemedAnimatedIcon.Source>
                                <animatedvisuals:SelectAllIcon/>
                            </wetool:ThemedAnimatedIcon.Source>
                            <wetool:ThemedAnimatedIcon.FallbackIconSource>
                                <FontIconSource Glyph="&#xE8B3;"/>
                            </wetool:ThemedAnimatedIcon.FallbackIconSource>
                        </wetool:ThemedAnimatedIcon>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Uid="Toolbar_InvertSelection"
                              Click="InvertSelection_CLick_ByCommandBarFlyout"
                              LabelPosition="Collapsed">
                    <AppBarButton.Icon>
                        <wetool:ThemedAnimatedIcon x:Name="ToolbarInvertSelectionIcon" AnimatedIcon.State="Normal" Width="16" Height="16">
                            <wetool:ThemedAnimatedIcon.Source>
                                <animatedvisuals:InvertSelection/>
                            </wetool:ThemedAnimatedIcon.Source>
                            <wetool:ThemedAnimatedIcon.FallbackIconSource>
                                <FontIconSource Glyph="&#xE8E6;"/>
                            </wetool:ThemedAnimatedIcon.FallbackIconSource>
                        </wetool:ThemedAnimatedIcon>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="RefreshButton" x:Uid="Toolbar_Refresh"
                              Click="WallpaperListRefresh_Click_ByCommandBarFlyout"
                              LabelPosition="Collapsed">
                    <AppBarButton.Icon>
                        <wetool:ThemedAnimatedIcon x:Name="ToolbarRefreshIcon" AnimatedIcon.State="Normal" Width="16" Height="16">
                            <wetool:ThemedAnimatedIcon.Source>
                                <animatedvisuals:RefreshIcon/>
                            </wetool:ThemedAnimatedIcon.Source>
                            <wetool:ThemedAnimatedIcon.FallbackIconSource>
                                <FontIconSource Glyph="&#xE777;"/>
                            </wetool:ThemedAnimatedIcon.FallbackIconSource>
                        </wetool:ThemedAnimatedIcon>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator/>
                <AppBarButton x:Name="ToolbarViewButton" x:Uid="Toolbar_View">
                    <!-- 有菜单小箭头:两层覆盖都要逐按钮写(官方 issue #10707 的配方)——
                         ① AppBarButtonHasFlyoutChevronVisibility:CommandBar 默认模板藏成 Collapsed,覆盖回 Visible;
                         ② AppBarButtonFlyoutGlyph 默认 E974(朝右)→ E972(朝下);溢出态 AppBarButtonOverflowFlyoutGlyph 一并换 -->
                    <AppBarButton.Resources>
                        <Visibility x:Key="AppBarButtonHasFlyoutChevronVisibility">Visible</Visibility>
                        <x:String x:Key="AppBarButtonFlyoutGlyph">&#xE972;</x:String>
                        <x:String x:Key="AppBarButtonOverflowFlyoutGlyph">&#xE972;</x:String>
                    </AppBarButton.Resources>
                    <AppBarButton.Icon>
                        <wetool:ThemedAnimatedIcon x:Name="ToolbarViewIcon" AnimatedIcon.State="Normal" Width="16" Height="16">
                            <wetool:ThemedAnimatedIcon.Source>
                                <animatedvisuals:ViewIcon/>
                            </wetool:ThemedAnimatedIcon.Source>
                            <wetool:ThemedAnimatedIcon.FallbackIconSource>
                                <FontIconSource Glyph="&#xE71D;"/>
                            </wetool:ThemedAnimatedIcon.FallbackIconSource>
                        </wetool:ThemedAnimatedIcon>
                    </AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <MenuFlyout x:Name="ToolbarViewFlyout" Placement="Bottom" Opened="FlyoutThemeRefresh_Opened">
                            <RadioMenuFlyoutItem x:Uid="AppBarButton_SmallIcon"
                                                 IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.SmallIconViewItem,Mode=TwoWay}"
                                                 GroupName="ViewGroup"/>
                            <RadioMenuFlyoutItem x:Uid="AppBarButton_MediumIcon"
                                                 IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.MediumIconViewItem,Mode=TwoWay}"
                                                 GroupName="ViewGroup"/>
                            <RadioMenuFlyoutItem x:Uid="AppBarButton_LargeIcon"
                                                 IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.LargeIconViewItem,Mode=TwoWay}"
                                                 GroupName="ViewGroup"/>
                            <RadioMenuFlyoutItem x:Uid="AppBarButton_ContentMode"
                                                 IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.ContentViewItem,Mode=TwoWay}"
                                                 GroupName="ViewGroup"/>
                            <RadioMenuFlyoutItem x:Uid="AppBarButton_ListMode"
                                                 IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.ListViewItem,Mode=TwoWay}"
                                                 GroupName="ViewGroup"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutSubItem x:Uid="MenuFlyoutSubItem_TagDisplay">
                                <RadioMenuFlyoutItem GroupName="LabelGroup"
                                                     x:Uid="AppBarButton_Type"
                                                     Click="OnTagDisplayChanged"
                                                     IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.TypeDisplayInTag, Mode=TwoWay}"/>
                                <RadioMenuFlyoutItem GroupName="LabelGroup"
                                                     x:Uid="AppBarButton_Rating"
                                                     Click="OnTagDisplayChanged"
                                                     IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.RatingDisplayInTag, Mode=TwoWay}"/>
                                <RadioMenuFlyoutItem GroupName="LabelGroup"
                                                     x:Uid="AppBarButton_Source"
                                                     Click="OnTagDisplayChanged"
                                                     IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.SourceDisplayInTag, Mode=TwoWay}"/>
                                <RadioMenuFlyoutItem GroupName="LabelGroup"
                                                     x:Uid="AppBarButton_Tag"
                                                     Click="OnTagDisplayChanged"
                                                     IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.TagDisplayInTag, Mode=TwoWay}"/>
                                <RadioMenuFlyoutItem GroupName="LabelGroup"
                                                     x:Uid="AppBarButton_None"
                                                     Click="OnTagDisplayChanged"
                                                     IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.NoneDisplayInTag, Mode=TwoWay}"/>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSubItem x:Uid="MenuFlyoutSubItem_PreviewBlur">
                                <ToggleMenuFlyoutItem x:Uid="Blur_Everyone"
                                                     IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.BlurEveryone, Mode=TwoWay}"/>
                                <ToggleMenuFlyoutItem x:Uid="Blur_Teen"
                                                     IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.BlurTeen, Mode=TwoWay}"/>
                                <ToggleMenuFlyoutItem x:Uid="Blur_Adult"
                                                     IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.BlurAdult, Mode=TwoWay}"/>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSubItem x:Uid="Pagination">
                                <RadioMenuFlyoutItem GroupName="PageSizeGroup" x:Uid="Pagination_None"
                                                     IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.NoPaginationItem, Mode=TwoWay}"/>
                                <RadioMenuFlyoutItem GroupName="PageSizeGroup" x:Uid="Pagination_30"
                                                     IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.PageSize30Item, Mode=TwoWay}"/>
                                <RadioMenuFlyoutItem GroupName="PageSizeGroup" x:Uid="Pagination_50"
                                                     IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.PageSize50Item, Mode=TwoWay}"/>
                                <RadioMenuFlyoutItem GroupName="PageSizeGroup" x:Uid="Pagination_70"
                                                     IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.PageSize70Item, Mode=TwoWay}"/>
                                <RadioMenuFlyoutItem GroupName="PageSizeGroup" x:Uid="Pagination_90"
                                                     IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.PageSize90Item, Mode=TwoWay}"/>
                            </MenuFlyoutSubItem>
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton x:Name="SortToolbarButton" x:Uid="Toolbar_Sort">
                    <!-- 有菜单小箭头:两层覆盖都要逐按钮写(官方 issue #10707 的配方)——
                         ① AppBarButtonHasFlyoutChevronVisibility:CommandBar 默认模板藏成 Collapsed,覆盖回 Visible;
                         ② AppBarButtonFlyoutGlyph 默认 E974(朝右)→ E972(朝下);溢出态 AppBarButtonOverflowFlyoutGlyph 一并换 -->
                    <AppBarButton.Resources>
                        <Visibility x:Key="AppBarButtonHasFlyoutChevronVisibility">Visible</Visibility>
                        <x:String x:Key="AppBarButtonFlyoutGlyph">&#xE972;</x:String>
                        <x:String x:Key="AppBarButtonOverflowFlyoutGlyph">&#xE972;</x:String>
                    </AppBarButton.Resources>
                    <AppBarButton.Icon>
                        <wetool:ThemedAnimatedIcon x:Name="ToolbarSortIcon" AnimatedIcon.State="Normal" Width="16" Height="16">
                            <wetool:ThemedAnimatedIcon.Source>
                                <animatedvisuals:SortIcon/>
                            </wetool:ThemedAnimatedIcon.Source>
                            <wetool:ThemedAnimatedIcon.FallbackIconSource>
                                <FontIconSource Glyph="&#xE8CB;"/>
                            </wetool:ThemedAnimatedIcon.FallbackIconSource>
                        </wetool:ThemedAnimatedIcon>
                    </AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <MenuFlyout x:Name="ToolbarSortFlyout" Placement="Bottom" Opened="FlyoutThemeRefresh_Opened">
                            <RadioMenuFlyoutItem GroupName="SortGroup"
                                                 x:Uid="SortByName"
                                                 Command="{x:Bind ViewModel.WallpaperDisplayVM.ChangeSortCommand}" CommandParameter="0"
                                                 Click="ChangeSort"
                                                 IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.SortByName, Mode=TwoWay}">
                            </RadioMenuFlyoutItem>
                            <RadioMenuFlyoutItem GroupName="SortGroup"
                                                 x:Uid="SortBySubTime"
                                                 Command="{x:Bind ViewModel.WallpaperDisplayVM.ChangeSortCommand}" CommandParameter="1"
                                                 Click="ChangeSort"
                                                 IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.SortBySubTime, Mode=TwoWay}">
                            </RadioMenuFlyoutItem>
                            <RadioMenuFlyoutItem GroupName="SortGroup"
                                                 x:Uid="SortByLastTime"
                                                 Command="{x:Bind ViewModel.WallpaperDisplayVM.ChangeSortCommand}" CommandParameter="2"
                                                 Click="ChangeSort"
                                                 IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.SortByLastTime, Mode=TwoWay}">
                            </RadioMenuFlyoutItem>
                            <RadioMenuFlyoutItem GroupName="SortGroup"
                                                 x:Uid="SortByAcfUpdateTime"
                                                 Command="{x:Bind ViewModel.WallpaperDisplayVM.ChangeSortCommand}" CommandParameter="4"
                                                 Click="ChangeSort"
                                                 IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.SortByAcfUpdateTime, Mode=TwoWay}">
                            </RadioMenuFlyoutItem>
                            <RadioMenuFlyoutItem GroupName="SortGroup"
                                                 x:Uid="SortByFileSize"
                                                 Command="{x:Bind ViewModel.WallpaperDisplayVM.ChangeSortCommand}" CommandParameter="3"
                                                 Click="ChangeSort"
                                                 IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.SortByFileSize, Mode=TwoWay}">
                            </RadioMenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <!-- 排序方向:与空白菜单同两项,也与旁边的 SortDirectionButton 共用 IsSortAscending -->
                            <RadioMenuFlyoutItem GroupName="SortDirectionGroup"
                                                 x:Uid="SortDirection_Increase"
                                                 IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.IsSortAscending, Mode=TwoWay}">
                            </RadioMenuFlyoutItem>
                            <RadioMenuFlyoutItem GroupName="SortDirectionGroup"
                                                 x:Uid="SortDirection_Decrease"
                                                 IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.IsSortDescending, Mode=TwoWay}">
                            </RadioMenuFlyoutItem>
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <!-- [A11y 2026-09] 讲述人朗读名随排序字段与方向变(静态 resw 键只讲得出按钮名) -->
                <AppBarButton x:Name="SortDirectionButton" x:Uid="Toolbar_SortDirection"
                              Click="SortDirectionToggle_Click"
                              AutomationProperties.Name="{x:Bind ViewModel.WallpaperDisplayVM.SortDirectionAutomationName, Mode=OneWay}"
                              LabelPosition="Collapsed">
                    <AppBarButton.Icon>
                        <wetool:ThemedAnimatedIcon x:Name="ToolbarSortDirectionIcon" AnimatedIcon.State="Normal" Width="16" Height="16">
                            <wetool:ThemedAnimatedIcon.Source>
                                <animatedvisuals:SortDirectionAscIcon/>
                            </wetool:ThemedAnimatedIcon.Source>
                            <wetool:ThemedAnimatedIcon.FallbackIconSource>
                                <FontIconSource Glyph="&#xE70D;"/>
                            </wetool:ThemedAnimatedIcon.FallbackIconSource>
                        </wetool:ThemedAnimatedIcon>
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
            <!-- 颜色取色载体(2026-09-19;不是诊断探针,删了图标就不跟主题变色)：“筛选结果”开关的图标在 .Icon 槽里，AppBarToggleButton 模板的选中色到不了
                 图标（见 Papers.xaml.cs“筛选结果图标颜色同步”）；这里借 {ThemeResource} 把该按钮家族在选中/未选中
                 下的两个前景色实例化出来，代码把它同步到图标自己的 Foreground（本地值必生效）。Collapsed 不参与布局。 -->
            <Border x:Name="LeftFilterColorProbeNormal" Grid.Column="1" Visibility="Collapsed"
                    Background="{ThemeResource AppBarToggleButtonForeground}"/>
            <Border x:Name="LeftFilterColorProbeChecked" Grid.Column="1" Visibility="Collapsed"
                    Background="{ThemeResource AppBarToggleButtonForegroundChecked}"/>
            <!-- 右侧：详情面板切换 -->
            <StackPanel Grid.Column="2" x:Name="RightToolbarPanel" Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton x:Name="RightToggleFilterButton"
                              BorderThickness="0"
                              Background="Transparent"
                              IsChecked="{x:Bind ViewModel.WallpaperDisplayVM.RightSplitViewPaneOpen, Mode=TwoWay}"
                              Margin="0,0,5,0">
                    <ToggleButton.Content>
                        <StackPanel Orientation="Horizontal">
                            <wetool:ThemedAnimatedIcon x:Name="RightToggleFilterIcon" AnimatedIcon.State="Normal" Width="16" Height="16" Margin="0,0,5,0" TrustForeground="True">
                                <wetool:ThemedAnimatedIcon.Source>
                                    <animatedvisuals:DetailPanelToggleIcon/>
                                </wetool:ThemedAnimatedIcon.Source>
                                <wetool:ThemedAnimatedIcon.FallbackIconSource>
                                    <FontIconSource Glyph="&#xE90D;"/>
                                </wetool:ThemedAnimatedIcon.FallbackIconSource>
                            </wetool:ThemedAnimatedIcon>
                            <TextBlock x:Uid="DetailsPanel" Margin="5,0,5,0"/>
                        </StackPanel>
                    </ToggleButton.Content>
                </ToggleButton>
            </StackPanel>
        </Grid>
        <SplitView 
                x:Name="RightSplitView" 
                PanePlacement="Right" 
                OpenPaneLength="340" 
                DisplayMode="Inline"
                PaneBackground="Transparent"
                Grid.Row="1"
                IsPaneOpen="{x:Bind ViewModel.WallpaperDisplayVM.RightSplitViewPaneOpen, Mode=TwoWay}">
            <SplitView.Pane>
                <ScrollView>
                    <Grid Padding="15,15,15,15" Background="Transparent" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                        <StackPanel Spacing="15">
                            <Grid x:Name="PreviewImageContainer" Height="290" Width="280" HorizontalAlignment="Center">
                                <Border x:Name="SinglePreviewBorder" Margin="0,10,0,0" Width="280" Height="280" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid>
                                        <Image x:Name="SinglePreviewImage" Source="{x:Bind ViewModel.SelectedWallpaper.Preview, Mode=OneWay, FallbackValue=null}" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5">
                                            <Image.RenderTransform>
                                                <ScaleTransform x:Name="ImageScale" />
                                            </Image.RenderTransform>
                                        </Image>
                                        <!-- 详情大图模糊层:与查看菜单"预览模糊"选项同步 -->
                                        <Image x:Name="SinglePreviewBlurOverlay" Stretch="UniformToFill" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>

                                <ItemsControl x:Name="StackedImagesControl" ItemsSource="{x:Bind DisplayedSelectedWallpapers}" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Grid/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:WallpaperItem">
                                            <Border Height="150" Width="150" CornerRadius="8" Loaded="StackedImage_Loaded" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{x:Bind Preview}" Stretch="UniformToFill"/>
                                                </Border.Background>
                                                <Image x:Name="StackBlurOverlay" Stretch="UniformToFill" Visibility="Collapsed"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <TextBlock x:Name="NoSelectionHintText"
                                       x:Uid="NoSelectionHint"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="16"
                                       Margin="0,20,0,0"
                                       TextWrapping="Wrap"/>

                            <StackPanel x:Name="SingleSelectionInfoPanel" Spacing="15" Visibility="Collapsed">
                                <TextBlock Text="{x:Bind ViewModel.SelectedWallpaper.Title, Mode=OneWay, FallbackValue=''}" 
                                           IsTextSelectionEnabled="{x:Bind ViewModel.WallpaperDisplayVM.DetailSelectionEnabled, Mode=OneWay}" 
                                           Style="{StaticResource TitleTextBlockStyle}" 
                                           TextWrapping="Wrap"
                                           FontSize="20"
                                           Margin="10,0,0,0"/>
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="10,0,0,0">
                                    <Button x:Name="DetailExtractButton" Command="{x:Bind ExtractSelectedCommand}" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <wetool:ThemedAnimatedIcon x:Name="DetailExtractIcon" AnimatedIcon.State="Normal" Width="14" Height="14">
                                                <wetool:ThemedAnimatedIcon.Source>
                                                    <animatedvisuals:ExtractIcon/>
                                                </wetool:ThemedAnimatedIcon.Source>
                                                <wetool:ThemedAnimatedIcon.FallbackIconSource>
                                                    <FontIconSource Glyph="&#xE72D;"/>
                                                </wetool:ThemedAnimatedIcon.FallbackIconSource>
                                            </wetool:ThemedAnimatedIcon>
                                            <TextBlock x:Uid="Detail_Extract" VerticalAlignment="Center" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="DetailCopyButton" Click="Copy_Click_ByCommandBarFlyout">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <!-- 复制图标:按下/松开两段播的是这份 Lottie;勾动画仍由下面的 FontIcon 承载(平时折叠,只在勾期间露面) -->
                                            <Grid>
                                                <wetool:ThemedAnimatedIcon x:Name="DetailCopyAnimatedIcon" AnimatedIcon.State="Normal" Width="14" Height="14">
                                                    <wetool:ThemedAnimatedIcon.Source>
                                                        <animatedvisuals:CopyIcon/>
                                                    </wetool:ThemedAnimatedIcon.Source>
                                                    <wetool:ThemedAnimatedIcon.FallbackIconSource>
                                                        <FontIconSource Glyph="&#xE8C8;"/>
                                                    </wetool:ThemedAnimatedIcon.FallbackIconSource>
                                                </wetool:ThemedAnimatedIcon>
                                                <FontIcon x:Name="DetailCopyIcon" Glyph="&#xE8C8;" FontSize="14" Visibility="Collapsed"/>
                                            </Grid>
                                            <TextBlock x:Uid="Detail_Copy" VerticalAlignment="Center" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                    <!-- [详情面板卸载 2026-09-21] 不再直接绑命令执行:详情面板只作用于当前这一张壁纸,
                                         改成在按钮处弹确认小卡(与「取消备份」同一套),比模态对话框轻。图标动画仍由
                                         普通 Button 模板驱动(按下/松开/点空回退),所以这里不再点一次播一遍。 -->
                                    <Button x:Name="DetailUninstallButton"
                                            Click="DetailUninstallButton_Click"
                                            IsEnabled="{x:Bind IsUninstallEnabled, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <wetool:ThemedAnimatedIcon AnimatedIcon.State="Normal" Width="14" Height="14">
                                                <wetool:ThemedAnimatedIcon.Source>
                                                    <animatedvisuals:DeleteIcon/>
                                                </wetool:ThemedAnimatedIcon.Source>
                                                <wetool:ThemedAnimatedIcon.FallbackIconSource>
                                                    <FontIconSource Glyph="&#xE74D;"/>
                                                </wetool:ThemedAnimatedIcon.FallbackIconSource>
                                            </wetool:ThemedAnimatedIcon>
                                            <TextBlock x:Uid="Detail_Uninstall" VerticalAlignment="Center" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="10,0,0,0">
                                    <Button x:Name="DetailImportToEditorButton"
                                            Click="ImportToEditor_Click"
                                            IsEnabled="{x:Bind IsImportToEditorEnabled, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <wetool:ThemedAnimatedIcon x:Name="DetailImportToEditorIcon" AnimatedIcon.State="Normal" Width="14" Height="14">
                                                <wetool:ThemedAnimatedIcon.Source>
                                                    <animatedvisuals:ImportToEditorIcon/>
                                                </wetool:ThemedAnimatedIcon.Source>
                                                <wetool:ThemedAnimatedIcon.FallbackIconSource>
                                                    <FontIconSource Glyph="&#xE70F;"/>
                                                </wetool:ThemedAnimatedIcon.FallbackIconSource>
                                            </wetool:ThemedAnimatedIcon>
                                            <TextBlock x:Uid="Detail_ImportToEditor" VerticalAlignment="Center" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                    <!-- [详情面板备份按钮 2026-09-21] 一枚按钮两用:当前这张壁纸已备份 → 文案「取消备份」,
                                         点击在按钮处弹确认小卡;未备份 → 文案「备份壁纸」,点击直接备份不弹层。
                                         文案/可用性由 UpdateDetailBackupButton 在选中项、工坊路径变化或一次备份操作结束后刷新
                                         (x:Bind OneWay 走属性通知)。图标 = 壁纸备份页在导航栏那一枚的 Lottie,
                                         状态切换由 Button 模板驱动(见 Papers.xaml.cs「详情面板按钮图标动画」段:不要再手动 SetState)。 -->
                                    <Button x:Name="DetailBackupButton"
                                            Click="DetailBackupButton_Click"
                                            IsEnabled="{x:Bind IsBackupActionEnabled, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <wetool:ThemedAnimatedIcon AnimatedIcon.State="Normal" Width="14" Height="14">
                                                <wetool:ThemedAnimatedIcon.Source>
                                                    <animatedvisuals:WallpaperBackupIcon/>
                                                </wetool:ThemedAnimatedIcon.Source>
                                                <wetool:ThemedAnimatedIcon.FallbackIconSource>
                                                    <FontIconSource Glyph="&#xF738;"/>
                                                </wetool:ThemedAnimatedIcon.FallbackIconSource>
                                            </wetool:ThemedAnimatedIcon>
                                            <TextBlock Text="{x:Bind DetailBackupActionText, Mode=OneWay}" VerticalAlignment="Center" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.SelectedWallpaper.FolderPath, Mode=OneWay, FallbackValue=''}" 
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="Gray" 
                                           TextWrapping="Wrap"
                                           IsTextSelectionEnabled="{x:Bind ViewModel.WallpaperDisplayVM.DetailSelectionEnabled, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.WallpaperDisplayVM.DetailPanelVisibility, Mode=OneWay}"
                                           Margin="10,0,0,0"/>
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="10,0,0,0">
                                    <Button x:Name="DetailOpenDirectoryButton" Command="{x:Bind OpenSelectedFoldersCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <wetool:ThemedAnimatedIcon x:Name="DetailOpenDirectoryIcon" AnimatedIcon.State="Normal" Width="14" Height="14">
                                                <wetool:ThemedAnimatedIcon.Source>
                                                    <animatedvisuals:OpenDirectoryIcon/>
                                                </wetool:ThemedAnimatedIcon.Source>
                                                <wetool:ThemedAnimatedIcon.FallbackIconSource>
                                                    <FontIconSource Glyph="&#xE838;"/>
                                                </wetool:ThemedAnimatedIcon.FallbackIconSource>
                                            </wetool:ThemedAnimatedIcon>
                                            <TextBlock x:Uid="Detail_OpenDirectory" VerticalAlignment="Center" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="DetailPropertiesButton" Click="Properties_Click_ByCommandBarFlyout">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <wetool:ThemedAnimatedIcon x:Name="DetailPropertiesIcon" AnimatedIcon.State="Normal" Width="14" Height="14">
                                                <wetool:ThemedAnimatedIcon.Source>
                                                    <animatedvisuals:PropertiesIcon/>
                                                </wetool:ThemedAnimatedIcon.Source>
                                                <wetool:ThemedAnimatedIcon.FallbackIconSource>
                                                    <FontIconSource Glyph="&#xE90F;"/>
                                                </wetool:ThemedAnimatedIcon.FallbackIconSource>
                                            </wetool:ThemedAnimatedIcon>
                                            <TextBlock x:Uid="Detail_Properties" VerticalAlignment="Center" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedWallpaper.FileSize, Mode=OneWay, Converter={StaticResource FileSizeToString}, FallbackValue=''}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="10,0,4,0"
                                               IsTextSelectionEnabled="{x:Bind ViewModel.WallpaperDisplayVM.DetailSelectionEnabled, Mode=OneWay}"/>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedWallpaper.Source, Mode=OneWay, Converter={StaticResource SourceToDisplay}, FallbackValue=''}" 
                                               Style="{StaticResource CaptionTextBlockStyle}" 
                                               FontWeight="SemiBold"
                                               Margin="4,0,4,0"
                                               IsTextSelectionEnabled="{x:Bind ViewModel.WallpaperDisplayVM.DetailSelectionEnabled, Mode=OneWay}"/>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedWallpaper.Type, Mode=OneWay, Converter={StaticResource TypeToDisplay}, FallbackValue=''}"
                                               Style="{StaticResource CaptionTextBlockStyle}" 
                                               FontWeight="SemiBold"
                                               Margin="4,0,4,0"
                                               IsTextSelectionEnabled="{x:Bind ViewModel.WallpaperDisplayVM.DetailSelectionEnabled, Mode=OneWay}"/>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedWallpaper.ContentRating, Mode=OneWay, Converter={StaticResource RatingToDisplay}, FallbackValue=''}" 
                                               Style="{StaticResource CaptionTextBlockStyle}" 
                                               FontWeight="SemiBold"
                                               Margin="4,0,4,0"
                                               IsTextSelectionEnabled="{x:Bind ViewModel.WallpaperDisplayVM.DetailSelectionEnabled, Mode=OneWay}"/>
                                </StackPanel>
                                <Grid>
                                    <Border Background="#20808080" 
                                            CornerRadius="4" 
                                            Padding="6,2" 
                                            Margin="10,4,4,0" 
                                            HorizontalAlignment="Left"
                                            Visibility="{x:Bind ViewModel.SelectedWallpaper.Tags, FallbackValue=Collapsed, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedWallpaper.Tags, Mode=OneWay, FallbackValue={x:Null}, Converter={StaticResource TagToDisplay}}" FontSize="12"/>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="DescriptionText" Text="{x:Bind ViewModel.SelectedWallpaper.Description, FallbackValue='', Mode=OneWay, Converter={StaticResource DescriptionToDisplay}}" 
                                           Style="{StaticResource BodyTextBlockStyle}" 
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="5"
                                           SizeChanged="DescriptionText_SizeChanged"
                                           IsTextSelectionEnabled="{x:Bind ViewModel.WallpaperDisplayVM.DetailSelectionEnabled, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.WallpaperDisplayVM.DetailPanelVisibility, Mode=OneWay}"
                                           Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                           Margin="10,0,0,0"/>
                                <HyperlinkButton x:Name="ExpandDescriptionButton"
                                                Click="ExpandDescriptionButton_Click"
                                                Visibility="Collapsed"
                                                HorizontalAlignment="Left"
                                                Margin="10,2,0,0"/>
                            </StackPanel>
                            <StackPanel x:Name="MultiSelectionInfoPanel" Spacing="10" Visibility="Collapsed" HorizontalAlignment="Stretch">
                                <TextBlock x:Name="MultiSelectCountText" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <Grid>
                                    <Button x:Uid="MultiSelect_SelectAll" Click="SelectAllWallpapers_Click" Width="150" Margin="0,0,4,0" HorizontalAlignment="Left" Style="{StaticResource AccentButtonStyle}"/>
                                    <Button x:Uid="MultiSelect_InvertSelection" Click="InvertSelection_CLick" Width="150" Margin="14,0,0,0" HorizontalAlignment="Right" />
                                </Grid>
                                <Button x:Uid="MultiSelect_Cancel" Click="CancelMultiSelect_Click" HorizontalAlignment="Stretch" Style="{StaticResource DefaultButtonStyle}"/>
                            </StackPanel>

                            <!-- 属性面板底部区：保存/加载指示 + 属性列表（仅属性模式显示；随整个面板一起滚动） -->
                        </StackPanel>
                    </Grid>
                </ScrollView>
            </SplitView.Pane>
            <SplitView.Content>
                <Grid>
                    <SplitView x:Name="LeftSplitView" PanePlacement="Left" OpenPaneLength="210" DisplayMode="Inline" PaneBackground="Transparent" IsPaneOpen="{x:Bind ViewModel.WallpaperDisplayVM.LeftSplitViewPaneOpen, Mode=TwoWay}">
                        <SplitView.Pane>
                            <!-- [分割线 2026-09] 右缘 1px 与右侧详情面板同款(之前这里 BorderBrush 挂着但 Thickness 全 0,等于没画) -->
                            <Grid Background="Transparent" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Padding="15,0,15,10">
                                        <Button Margin="0,10,0,5" HorizontalAlignment="Stretch" Click="ResetFilter_Click" Style="{StaticResource AccentButtonStyle}" Grid.Row="0">
                                            <Button.Content>
                                                <StackPanel Orientation="Horizontal">
                                                    <FontIcon Glyph="&#xE895;" Margin="10,0,10,0"/>
                                                    <TextBlock x:Uid="ResetFilters"/>
                                                </StackPanel>
                                            </Button.Content>
                                        </Button>
                                        <Expander x:Uid="Subscription" x:Name="SubscriptionExpander" HorizontalAlignment="Stretch" Margin="0,4,0,4" IsExpanded="{x:Bind ViewModel.FilterExpanderVM.SubscriptionExpander, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            ContextFlyout="{StaticResource FilterExpanderContextMenu}">
                                            <StackPanel x:Name="SubscriptionFilterPanel">
                                                <CheckBox x:Uid="Subscription_Subscribed" Tag="Subscribed" IsChecked="{x:Bind ViewModel.FilterExpanderVM.Subscribed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox x:Uid="Subscription_Unsubscribed" Tag="Unsubscribed" IsChecked="{x:Bind ViewModel.FilterExpanderVM.Unsubscribed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </Expander>
                                        <Expander x:Uid="Type" x:Name="TypeExpander" HorizontalAlignment="Stretch" Margin="0,4,0,4" IsExpanded="{x:Bind ViewModel.FilterExpanderVM.TypeExpander, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            ContextFlyout="{StaticResource FilterExpanderContextMenu}">
                                            <StackPanel x:Name="TypeFilterPanel">
                                                <CheckBox x:Uid="Type_Scene" Tag="Scene" IsChecked="{x:Bind ViewModel.FilterExpanderVM.Scene, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox x:Uid="Type_Video" Tag="Video" IsChecked="{x:Bind ViewModel.FilterExpanderVM.Video, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox x:Uid="Type_Web" Tag="Web" IsChecked="{x:Bind ViewModel.FilterExpanderVM.Web, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox x:Uid="Type_Application" Tag="Application" IsChecked="{x:Bind ViewModel.FilterExpanderVM.Application, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox x:Uid="Type_Preset" Tag="Preset" IsChecked="{x:Bind ViewModel.FilterExpanderVM.Preset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox x:Uid="Type_Unknown" Tag="Unknow" IsChecked="{x:Bind ViewModel.FilterExpanderVM.Unknown, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </Expander>

                                        <Expander x:Uid="Rating" x:Name="AgeExpander" HorizontalAlignment="Stretch" Margin="0,4,0,4" IsExpanded="{x:Bind ViewModel.FilterExpanderVM.RatingExpander, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            ContextFlyout="{StaticResource FilterExpanderContextMenu}">
                                            <StackPanel x:Name="AgeRatingFilterPanel">
                                                <CheckBox x:Uid="Rating_Everyone" Tag="G" IsChecked="{x:Bind ViewModel.FilterExpanderVM.G, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox x:Uid="Rating_Questionable" Tag="PG" IsChecked="{x:Bind ViewModel.FilterExpanderVM.Pg, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox x:Uid="Rating_Mature" Tag="R" IsChecked="{x:Bind ViewModel.FilterExpanderVM.R, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </Expander>

                                        <Expander x:Uid="Source" x:Name="SourceExpander" HorizontalAlignment="Stretch" Margin="0,4,0,4" IsExpanded="{x:Bind ViewModel.FilterExpanderVM.SourceExpander, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            ContextFlyout="{StaticResource FilterExpanderContextMenu}">
                                            <StackPanel x:Name="SourceFilterPanel">
                                                <CheckBox x:Uid="Source_Official" Tag="Official" IsChecked="{x:Bind ViewModel.FilterExpanderVM.Official, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox x:Uid="Source_Workshop" Tag="Workshop" IsChecked="{x:Bind ViewModel.FilterExpanderVM.Workshop, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox x:Uid="Source_Mine" Tag="Mine" IsChecked="{x:Bind ViewModel.FilterExpanderVM.Mine, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </Expander>

                                        <Expander x:Uid="Tag" x:Name="TagsExpander" HorizontalAlignment="Stretch" Margin="0,4,0,4" IsExpanded="{x:Bind ViewModel.FilterExpanderVM.TagsExpander, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            ContextFlyout="{StaticResource FilterExpanderContextMenu}">
                                            <StackPanel x:Name="TagsContainer">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button x:Uid="All" Click="SelectAllTags_Click" HorizontalAlignment="Stretch" Grid.Column="0"/>
                                                    <Button x:Uid="None" Click="DeselectAllTags_Click" HorizontalAlignment="Stretch" Grid.Column="1"/>
                                                </Grid>
                                                <CheckBox x:Uid="Tag_Abstract" Tag="Abstract" IsChecked="{x:Bind ViewModel.FilterExpanderVM.Abstract, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox x:Uid="Tag_Animal" Tag="Animal" IsChecked="{x:Bind ViewModel.FilterExpanderVM.Animal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <CheckBox x:Uid="Tag_Anime" Tag="Anime" IsChecked="{x:Bind ViewModel.FilterExpanderVM.Anime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox x:Uid="Tag_Cartoon" Tag="Cartoon" IsChecked="{x:Bind ViewModel.FilterExpanderVM.Cartoon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox x:Uid="Tag_CGI" Tag="CGI" IsChecked="{x:Bind ViewModel.FilterExpanderVM.Cgi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox x:Uid="Tag_Cyberpunk" Tag="Cyberpunk" IsChecked="{x:Bind ViewModel.FilterExpanderVM.Cyberpunk, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox x:Uid="Tag_Fantasy" Tag="Fantasy" IsChecked="{x:Bind ViewModel.FilterExpanderVM.Fantasy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox x:Uid="Tag_Game" Tag="Game" IsChecked="{x:Bind ViewModel.FilterExpanderVM.Game, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox x:Uid="Tag_Girls" Tag="Girls" IsChecked="{x:Bind ViewModel.FilterExpanderVM.Girls, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox x:Uid="Tag_Guys" Tag="Guys" IsChecked="{x:Bind ViewModel.FilterExpanderVM.Guys, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox x:Uid="Tag_Landscape" Tag="Landscape" IsChecked="{x:Bind ViewModel.FilterExpanderVM.Landscape, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox x:Uid="Tag_Medieval" Tag="Medieval" IsChecked="{x:Bind ViewModel.FilterExpanderVM.Medieval, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox x:Uid="Tag_Memes" Tag="Memes" IsChecked="{x:Bind ViewModel.FilterExpanderVM.Memes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox x:Uid="Tag_MMD" Tag="MMD" IsChecked="{x:Bind ViewModel.FilterExpanderVM.Mmd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox x:Uid="Tag_Music" Tag="Music" IsChecked="{x:Bind ViewModel.FilterExpanderVM.Music, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox x:Uid="Tag_Nature" Tag="Nature" IsChecked="{x:Bind ViewModel.FilterExpanderVM.Nature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox x:Uid="Tag_Pixelart" Tag="Pixelart" IsChecked="{x:Bind ViewModel.FilterExpanderVM.Pixelart, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox x:Uid="Tag_Relaxing" Tag="Relaxing" IsChecked="{x:Bind ViewModel.FilterExpanderVM.Relaxing, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox x:Uid="Tag_Retro" Tag="Retro" IsChecked="{x:Bind ViewModel.FilterExpanderVM.Retro, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox x:Uid="Tag_SciFi" Tag="SciFi" IsChecked="{x:Bind ViewModel.FilterExpanderVM.SciFi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox x:Uid="Tag_Sports" Tag="Sports" IsChecked="{x:Bind ViewModel.FilterExpanderVM.Sports, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox x:Uid="Tag_Technology" Tag="Technology" IsChecked="{x:Bind ViewModel.FilterExpanderVM.Technology, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox x:Uid="Tag_Television" Tag="Television" IsChecked="{x:Bind ViewModel.FilterExpanderVM.Television, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox x:Uid="Tag_Vehicle" Tag="Vehicle" IsChecked="{x:Bind ViewModel.FilterExpanderVM.Vehicle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox x:Uid="Tag_Unspecified" Tag="Unspecified" IsChecked="{x:Bind ViewModel.FilterExpanderVM.Unspecified, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </ScrollView>
                            </Grid>
                        </SplitView.Pane>

                        <SplitView.Content>
                            <Grid>
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- [扫描进度 2026-09] 首次加载/刷新扫描时覆盖列表区中央的转圈指示(不确定进度) -->
                                    <ProgressRing x:Name="ScanProgressRing"
                                                  IsActive="False"
                                                  Visibility="Collapsed"
                                                  Width="48" Height="48"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Grid.Row="0"/>

                                    <!-- [实验] WallpapersGridView → ScrollView+ItemsRepeater:只显示 preview,验证万条 resize 卡顿 -->
                                    <wetool:CtrlAwareScrollView x:Name="WallpapersScrollViewExp"
                                                Visibility="{x:Bind ViewModel.WallpaperDisplayVM.IconModeVisibility, Mode=OneWay}"
                                                VerticalScrollBarVisibility="Auto"
                                                VerticalScrollMode="Auto"
                                                HorizontalScrollBarVisibility="Hidden"
                                                HorizontalScrollMode="Disabled"
                                                SizeChanged="WallpapersScrollViewExp_SizeChanged"
                                                Tapped="WallpaperList_Tapped"
                                                Margin="4,0,4,0">
                                    <wetool:CtrlAwareScrollView.Resources>
                                        <!-- [scrollbar 右移 3px 2026-09] 覆盖 ScrollView 模板的缩进资源(默认 Thickness=1=四边各 1px):
                                             Right 1→-2 → 竖向 bar 右移 3px;只挂本条 ScrollView,左右面板的 ScrollView 不受影响 -->
                                        <Thickness x:Key="ScrollViewScrollBarsMargin">1,1,-2,1</Thickness>
                                    </wetool:CtrlAwareScrollView.Resources>
                                        <ItemsRepeater x:Name="WallpapersRepeater"
                                                       ItemsSource="{x:Bind Wallpapers}"
                                                       PointerWheelChanged="WallpapersRepeater_PointerWheelChanged"
                                                       Margin="0,0,10,0">
                                            <ItemsRepeater.Layout>
                                                <!-- [防崩] MinItemWidth 由代码钳制(见 WallpapersScrollViewExp_SizeChanged):
                                                     可用宽 < MinItemWidth → UniformGridLayout itemsPerLine=0 除零崩溃(#10539) -->
                                                <UniformGridLayout x:Name="WallpapersUniformLayoutExp"
                                                                   MinColumnSpacing="10"
                                                                   MinRowSpacing="10"
                                                                   ItemsStretch="Fill"
                                                                   Orientation="Horizontal"/>
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="models:WallpaperItem">
                                                    <!-- [外观还原] 与 GridView 时代一致:圆角8卡片+图+title 条+角标+checkbox(视觉)。
                                                         交互事件暂不挂(阶段 1 只还原外观)。
                                                         [去阴影 2026-09-26] 原"阴影层 + Translation 抬高"一并撤掉,卡片平铺在列表背景上 -->
                                                    <Grid x:Name="ItemContainer">
                                                        <Grid CornerRadius="8"
                                                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                              PointerEntered="Item_PointerEntered"
                                                              PointerExited="Item_PointerExited"
                                                              PointerReleased="Item_PointerReleased"
                                                              PointerPressed="Item_PointerPressed"
                                                              RenderTransformOrigin="0.5,0.5"
                                                              x:Name="ItemRootGrid"
                                                              DataContext="{x:Bind}"
                                                              Loaded="ShadowRect_Loaded"
                                                              RightTapped="WallpaperItem_RightTapped">
                                                            <!-- 布局撑高:UniformGridLayout 拉伸填满,Viewbox 占位保比例(与原 GridView 卡片同构) -->
                                                            <Viewbox Stretch="Uniform" VerticalAlignment="Top">
                                                                <Canvas Width="100" Height="100"/>
                                                            </Viewbox>

                                                            <Image x:Name="ItemPreviewImage" Stretch="UniformToFill"/>
                                                            <!-- Skia 流式 GIF 播放(GIF 时显示覆盖,ElementPrepared 里 Start/Stop) -->
                                                            <skia:SkiaGifView x:Name="SkiaGifCanvas" Visibility="Collapsed"/>
                                                            <!-- 内容过滤模糊层:露骨壁纸按年龄段设置显示高斯模糊位图,平时隐藏 -->
                                                            <Image x:Name="ItemBlurOverlay" Stretch="UniformToFill" Visibility="Collapsed"/>

                                                            <Grid VerticalAlignment="Bottom" Height="45" Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <!-- [A11y 2026-09] x:Name 供 ElementPrepared 做朗读去重(讲述人不重复念同一张卡),见 Papers.xaml.cs -->
                                                                <TextBlock Grid.Column="0"
                                                                           x:Name="ItemTitleText"
                                                                           Text="{x:Bind Title}" 
                                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" 
                                                                           FontSize="12" 
                                                                           VerticalAlignment="Center"
                                                                           HorizontalAlignment="Center"
                                                                           Margin="4,4,4,4" 
                                                                           TextTrimming="CharacterEllipsis"
                                                                           TextWrapping="WrapWholeWords"/>
                                                                <!-- 异常角标(ShouldNotExist = 未订阅或已下架):数据驱动,平时 Collapsed -->
                                                                <Border Grid.Column="1"
                                                                        CornerRadius="4"
                                                                        Padding="6,2"
                                                                        Margin="4,0,6,0"
                                                                        Background="#20808080"
                                                                        VerticalAlignment="Center"
                                                                        Visibility="{x:Bind ShouldNotExist, Mode=OneWay, FallbackValue=Collapsed}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                                        <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                                                                        <TextBlock x:Uid="Unsubscribed_Badge" FontSize="12" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </Grid>
                                                            <Border HorizontalAlignment="Right"
                                                                        VerticalAlignment="Top"
                                                                        BorderBrush="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                                        CornerRadius="0,0,0,10"
                                                                        MinWidth="50"
                                                                        MinHeight="20"
                                                                        Padding="4"
                                                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                                        Visibility="Collapsed"
                                                                        x:Name="TagDisplayBorder">
                                                                <!-- 文本/可见性由 UpdateTagBadge 代码设置(替代 x:Bind OneTime+列表重建) -->
                                                                <TextBlock Text=""
                                                                           HorizontalAlignment="Center"
                                                                           FontSize="12"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>
                                                            <CheckBox x:Name="SelectionCheckBox"
                                                                      IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                                      Opacity="{x:Bind CheckBoxOpacity, Mode=OneWay}"
                                                                      VerticalAlignment="Top"
                                                                      HorizontalAlignment="Left"
                                                                      Margin="10,8,0,0"
                                                                      Click="SelectionCheckBox_Click"
                                                                      Background="Transparent"
                                                                      CornerRadius="6"
                                                                      MinWidth="0" MinHeight="0" Padding="0" Width="24" Height="24"
                                                                      UseLayoutRounding="True"
                                                                      Content="{x:Null}" 
                                                                      HorizontalContentAlignment="Center"
                                                                      VerticalContentAlignment="Center">
                                                                <CheckBox.Resources>
                                                                    <!-- 未选中状态 -->
                                                                    <StaticResource x:Key="CheckBoxCheckBackgroundFillUnchecked" 
                                                                            ResourceKey="SystemControlBackgroundChromeWhiteBrush" />
                                                                    <StaticResource x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" 
                                                                            ResourceKey="SystemControlBackgroundChromeWhiteBrush" />
                                                                </CheckBox.Resources>
                                                            </CheckBox>
                                                        </Grid>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </wetool:CtrlAwareScrollView>

                                    <!-- [全迁 ItemsRepeater] 内容模式(单列行卡):GridView → CtrlAwareScrollView+ItemsRepeater+StackLayout -->
                                    <wetool:CtrlAwareScrollView x:Name="WallpapersContentScrollViewExp"
                                                Visibility="{x:Bind ViewModel.WallpaperDisplayVM.ContentModeVisibility, Mode=OneWay}"
                                                VerticalScrollBarVisibility="Auto"
                                                VerticalScrollMode="Auto"
                                                HorizontalScrollBarVisibility="Hidden"
                                                HorizontalScrollMode="Disabled"
                                                SizeChanged="WallpapersContentScrollViewExp_SizeChanged"
                                                Tapped="WallpaperList_Tapped"
                                                Margin="4,0,4,0">
                                    <wetool:CtrlAwareScrollView.Resources>
                                        <!-- [scrollbar 右移 3px 2026-09] 覆盖 ScrollView 模板的缩进资源(默认 Thickness=1=四边各 1px):
                                             Right 1→-2 → 竖向 bar 右移 3px;只挂本条 ScrollView,左右面板的 ScrollView 不受影响 -->
                                        <Thickness x:Key="ScrollViewScrollBarsMargin">1,1,-2,1</Thickness>
                                    </wetool:CtrlAwareScrollView.Resources>
                                        <ItemsRepeater x:Name="WallpapersContentRepeater"
                                                       ItemsSource="{x:Bind Wallpapers}">
                                            <ItemsRepeater.Layout>
                                                <!-- 内容模式单列:StackLayout 垂直列表。间距 8 与列表模式(行高 36/间隔 4)
                                                     保持同一视觉比例;原先 Spacing=0 让相邻行卡贴成一块 -->
                                                <StackLayout Spacing="8" Orientation="Vertical"/>
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="models:WallpaperItem">
                                                    <Grid x:Name="ContentItemContainer"
                                                          Height="86"
                                                          CornerRadius="4"
                                                          Padding="8,4"
                                                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                          DataContext="{x:Bind}"
                                                          RenderTransformOrigin="0.5,0.5"
                                                          Loaded="ShadowRect_Loaded"
                                                          PointerEntered="ContentItem_PointerEntered"
                                                          PointerExited="ContentItem_PointerExited"
                                                          PointerReleased="ContentItem_PointerReleased"
                                                          PointerPressed="ContentItem_PointerPressed"
                                                          RightTapped="ContentItem_RightTapped"
                                                          ContextFlyout="{StaticResource WallpaperContextMenu}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="40"/>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="120"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- 选择框 -->
                                                        <CheckBox x:Name="ContentSelectionCheckBox"
                                                                  Grid.Column="0"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Opacity="{x:Bind CheckBoxOpacity, Mode=OneWay}"
                                                                  IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                                  Click="SelectionCheckBox_Click"
                                                                  Background="Transparent"
                                                                  CornerRadius="4"
                                                                  MinWidth="0" MinHeight="0" Padding="0" Width="20" Height="20"
                                                                  UseLayoutRounding="True"
                                                                  Content="{x:Null}" 
                                                                  HorizontalContentAlignment="Center"
                                                                  VerticalContentAlignment="Center"/>
                                                        <!-- 缩略图(内容模式 GIF 仍用 BitmapImage AutoPlay 播放,与迁移前一致) -->
                                                        <Grid Grid.Column="1" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                                            <Image Stretch="UniformToFill" Width="80" Height="80">
                                                                <Image.Source>
                                                                    <BitmapImage UriSource="{x:Bind Preview}" 
                                                                         AutoPlay="{Binding DataContext.ViewModel.WallpaperDisplayVM.AutoPlayGif, ElementName=PageRoot, Mode=OneWay}"/>
                                                                </Image.Source>
                                                            </Image>
                                                        </Grid>
                                                        <!-- 标题 -->
                                                        <TextBlock Grid.Column="2" 
                                                                   x:Name="ContentTitleText"
                                                                   Text="{x:Bind Title}" 
                                                                   VerticalAlignment="Center"
                                                                   Margin="12,0,8,0"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Style="{ThemeResource SubtitleTextBlockStyle}"/>
                                                        <!-- 类型 -->
                                                        <TextBlock Grid.Column="3" 
                                                                   Text="{x:Bind Type, Converter={StaticResource TypeToDisplay}}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="4,0"
                                                                   FontSize="12"
                                                                   Foreground="{ThemeResource SystemAccentColor}"/>
                                                        <!-- 分级 -->
                                                        <TextBlock Grid.Column="4" 
                                                                   Text="{x:Bind ContentRating, Converter={StaticResource RatingToDisplay}}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="4,0"
                                                                   FontSize="12"/>
                                                        <!-- 来源 -->
                                                        <TextBlock Grid.Column="5" 
                                                                   Text="{x:Bind Source, Converter={StaticResource SourceToDisplay}}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="4,0"
                                                                   FontSize="12"
                                                                   Foreground="Gray"/>
                                                        <!-- 文件大小 -->
                                                        <TextBlock Grid.Column="6" 
                                                                   Text="{x:Bind FileSize, Converter={StaticResource FileSizeToString}}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="4,0"
                                                                   FontSize="12"
                                                                   TextAlignment="Right"/>
                                                        <!-- 标签 -->
                                                        <TextBlock Grid.Column="7" 
                                                                   Text="{x:Bind Tags, Converter={StaticResource TagToDisplay}}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="4,0"
                                                                   FontSize="12"
                                                                   MaxWidth="150"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <!-- 更新时间 -->
                                                        <TextBlock Grid.Column="8" 
                                                                   Text="{x:Bind UpdateTime, Converter={StaticResource DateTimeToString}}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="4,0"
                                                                   FontSize="12"
                                                                   Foreground="Gray"
                                                                   TextAlignment="Right"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </wetool:CtrlAwareScrollView>

                                    <!-- [全迁 ItemsRepeater] 列表模式(多列行卡):GridView → CtrlAwareScrollView+ItemsRepeater+UniformGridLayout -->
                                    <wetool:CtrlAwareScrollView x:Name="WallpapersListScrollViewExp"
                                                Visibility="{x:Bind ViewModel.WallpaperDisplayVM.ListModeVisibility, Mode=OneWay}"
                                                VerticalScrollBarVisibility="Auto"
                                                VerticalScrollMode="Auto"
                                                HorizontalScrollBarVisibility="Hidden"
                                                HorizontalScrollMode="Disabled"
                                                SizeChanged="WallpapersListScrollViewExp_SizeChanged"
                                                Tapped="WallpaperList_Tapped"
                                                Margin="4,0,4,0">
                                    <wetool:CtrlAwareScrollView.Resources>
                                        <!-- [scrollbar 右移 3px 2026-09] 覆盖 ScrollView 模板的缩进资源(默认 Thickness=1=四边各 1px):
                                             Right 1→-2 → 竖向 bar 右移 3px;只挂本条 ScrollView,左右面板的 ScrollView 不受影响 -->
                                        <Thickness x:Key="ScrollViewScrollBarsMargin">1,1,-2,1</Thickness>
                                    </wetool:CtrlAwareScrollView.Resources>
                                        <ItemsRepeater x:Name="WallpapersListRepeater"
                                                       ItemsSource="{x:Bind Wallpapers}"
                                                       Margin="0,0,10,0">
                                            <ItemsRepeater.Layout>
                                                <!-- 列表模式多列(400 档位):MinItemWidth 由代码钳制 -->
                                                <UniformGridLayout x:Name="WallpapersListUniformLayoutExp"
                                                    MinColumnSpacing="10"
                                                    MinRowSpacing="4"
                                                    ItemsStretch="Fill"
                                                    Orientation="Horizontal"/>
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="models:WallpaperItem">
                                                    <Grid x:Name="ListItemContainer"
                                                          Height="36"
                                                          CornerRadius="4"
                                                          Padding="8,4"
                                                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                          DataContext="{x:Bind}"
                                                          RenderTransformOrigin="0.5,0.5"
                                                          Loaded="ShadowRect_Loaded"
                                                          PointerEntered="ContentItem_PointerEntered"
                                                          PointerExited="ContentItem_PointerExited"
                                                          PointerReleased="ContentItem_PointerReleased"
                                                          PointerPressed="ContentItem_PointerPressed"
                                                          RightTapped="ContentItem_RightTapped"
                                                          ContextFlyout="{StaticResource WallpaperContextMenu}">
                                                        <Grid ColumnSpacing="6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox x:Name="ListSelectionCheckBox"
                                                                      VerticalAlignment="Center"
                                                                      Opacity="{x:Bind CheckBoxOpacity, Mode=OneWay}"
                                                                      IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                                      Click="SelectionCheckBox_Click"
                                                                      Background="Transparent"
                                                                      CornerRadius="4"
                                                                      MinWidth="0" MinHeight="0" Padding="0"
                                                                      UseLayoutRounding="True"
                                                                      Content="{x:Null}" 
                                                                      HorizontalContentAlignment="Center"
                                                                      VerticalContentAlignment="Center"/>
                                                            <TextBlock Text="{x:Bind Title}"
                                                                       x:Name="ListTitleText"
                                                                       Grid.Column="1"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="13"
                                                                       FontWeight="Normal"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </Grid>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </wetool:CtrlAwareScrollView>

                                        <StackPanel x:Name="NoScanResultTip" Visibility="Collapsed" Margin="0,100,0,0" HorizontalAlignment="Center">
                                            <TextBlock x:Uid="NoScanResultTip"
                                                       Style="{StaticResource TitleTextBlockStyle}"
                                                       FontSize="20"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,20"/>
                                            <Button x:Uid="GoToSettings"
                                                    Click="GoToSettings_Click"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel x:Name="NoResultTip" Visibility="Collapsed" Margin="0,100,0,0">
                                            <TextBlock x:Uid="NoResultTip1"
                                                   Style="{StaticResource TitleTextBlockStyle}" 
                                                   TextWrapping="Wrap"
                                                   FontSize="20"
                                                   HorizontalAlignment="Center"/>
                                            <TextBlock x:Uid="NoResultTip2"
                                                   Style="{StaticResource TitleTextBlockStyle}" 
                                                   TextWrapping="Wrap"
                                                   FontSize="20"
                                                   HorizontalAlignment="Center"/>
                                            <TextBlock x:Uid="NoResultTip3"
                                                   Style="{StaticResource TitleTextBlockStyle}" 
                                                   TextWrapping="Wrap"
                                                   FontSize="20"
                                                   HorizontalAlignment="Center"/>
                                        </StackPanel>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4" Margin="0,8,0,0"
                                            Visibility="{x:Bind ViewModel.WallpaperDisplayVM.PaginationBarVisibility, Mode=OneWay}">
                                            <Button x:Uid="Pagination_PrevPage" x:Name="PrevPageButton"
                                                    Click="PrevPage_Click"
                                                    IsEnabled="{x:Bind CanGoPrevious, Mode=OneWay}"
                                                    Style="{StaticResource SubtleButtonStyle}">
                                                <FontIcon Glyph="&#xE76B;" FontSize="14"/>
                                            </Button>
                                            <StackPanel x:Name="PageNumbersPanel" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"/>
                                            <Button x:Uid="Pagination_NextPage" x:Name="NextPageButton"
                                                    Click="NextPage_Click"
                                                    IsEnabled="{x:Bind CanGoNext, Mode=OneWay}"
                                                    Style="{StaticResource SubtleButtonStyle}">
                                                <FontIcon Glyph="&#xE76C;" FontSize="14"/>
                                            </Button>
                                        </StackPanel>
                                </Grid>
                            </Grid>
                        </SplitView.Content>
                    </SplitView>
                </Grid>
            </SplitView.Content>
        </SplitView>

        <Grid Grid.Row="2" MinWidth="300" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <FontIcon Glyph="&#xE74E;" Margin="15,0,0,0"/>
                <TextBlock x:Uid="ExportDirectory" Margin="4,0,0,0" VerticalAlignment="Center"/>
                <Button Style="{StaticResource SubtleButtonStyle}"
                        VerticalAlignment="Center"
                        Margin="0,5,0,0"
                        Command="{x:Bind ViewModel.PathManagementVM.AutoDetectDownloadPathCommand}">
                    <Button.Content>
                        <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                    </Button.Content>
                </Button>
            </StackPanel>
            <TextBox Grid.Column="1" x:Uid="PapersBottomTextBox" Text="{x:Bind ViewModel.PathManagementVM.DownloadPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
            <StackPanel VerticalAlignment="Center" Grid.Column="2" Orientation="Horizontal">
                <Button Margin="0,0,0,0" x:Uid="SelectFolder" Command="{x:Bind ViewModel.PathManagementVM.BrowseFolderCommand}" CommandParameter="DownloadPath" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center"/>
                <Button Margin="4,0,8,0" x:Uid="OpenFolder" Command="{x:Bind ViewModel.PathManagementVM.OpenFolderCommand}" CommandParameter="DownloadPath" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
        <!-- 提取进度覆盖 -->
        <Grid x:Name="ExtractOverlay"
              Visibility="{x:Bind ExtractOverlayVisibility, Mode=OneWay}"
              Grid.RowSpan="3"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Rectangle x:Name="ExtractOverlayBackground" Fill="#80000000"/>
            <Border x:Name="ExtractPanel"
                    Width="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    CornerRadius="12"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Margin="0,80,0,80">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- 标题栏(固定) -->
                    <Grid Padding="16,12,12,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE118;" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock x:Uid="ExtractProgressTitle" Style="{StaticResource TitleTextBlockStyle}" 
                                   FontSize="18" VerticalAlignment="Center" Margin="8,0,0,0" Grid.Column="1"/>
                        <Button Grid.Column="2"
                                x:Name="ExtractCloseButton"
                                Click="ExtractCloseButton_Click"
                                Style="{StaticResource SubtleButtonStyle}">
                            <FontIcon Glyph="&#xE711;" FontSize="9"/>
                        </Button>
                    </Grid>
                    <!-- 滚动区:壁纸列表(多壁纸)/ 预览图(单壁纸),窗口矮时此处滚动,不影响底部按钮 -->
                    <ScrollView x:Name="ExtractScrollArea" Grid.Row="1"
                                VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto"
                                HorizontalScrollMode="Disabled">
                        <!-- MinHeight = 滚动区视口高度:大窗口列表撑满,小窗口内容超出时 ScrollView 接管滚动 -->
                        <Grid MinHeight="{x:Bind ExtractScrollArea.ActualHeight, Mode=OneWay}">
                            <!-- 多壁纸提取:正在提取的壁纸列表(每项实时进度条) -->
                            <ListView x:Name="ExtractWallpaperList" ItemsSource="{x:Bind ExtractProgressItems}" Visibility="Collapsed"
                                      SelectionMode="None" IsItemClickEnabled="False">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ExtractProgressItem">
                                        <Grid ColumnSpacing="10" Padding="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="44" Height="44" CornerRadius="6"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                <Image Source="{x:Bind Preview}" Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                                <TextBlock Text="{x:Bind Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" Height="4"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <!-- 单壁纸模式:预览图居中(与列表互斥显示) -->
                            <StackPanel VerticalAlignment="Center" Visibility="{x:Bind ExtractPreviewVisibility, Mode=OneWay}">
                                <Border x:Name="ExtractPreviewBorder" Width="160" Height="160" HorizontalAlignment="Center" CornerRadius="8" Margin="0,0,0,4"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Image x:Name="ExtractPreviewImage" Stretch="UniformToFill"/>
                                </Border>
                                <TextBlock x:Name="ExtractPreviewTitle" Text="" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,12"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                            </StackPanel>
                        </Grid>
                    </ScrollView>
                    <!-- 底部:总进度条 + 汇总文本(固定,不随滚动区滚动) -->
                    <StackPanel Grid.Row="2" Margin="24,16,24,0">
                        <ProgressBar x:Name="ExtractProgressBar"
                                     Value="{x:Bind ExtractProgress, Mode=OneWay}"
                                     Maximum="100"
                                     ShowPaused="{x:Bind IsPaused, Mode=OneWay}"
                                     Height="6"/>
                        <TextBlock Text="{x:Bind ExtractSubText, Mode=OneWay}" 
                                   FontSize="13" HorizontalAlignment="Center" Margin="0,8,0,0"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                        <TextBlock Text="{x:Bind ExtractStatus, Mode=OneWay}" 
                                   FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                   Visibility="{x:Bind ExtractStatusVisibility, Mode=OneWay}"/>
                    </StackPanel>
                    <!-- 当前提取项信息（单壁纸模式下显示当前处理的文件） -->
                    <StackPanel Grid.Row="3" Margin="24,4,24,12">
                        <TextBlock Text="{x:Bind ExtractEntryText, Mode=OneWay}"
                                   FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{x:Bind ExtractEntryVisibility, Mode=OneWay}"/>
                    </StackPanel>
                    <!-- 按钮栏(固定) -->
                    <Grid Grid.Row="4" Padding="12,8,12,12" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1" x:Name="PauseButton"
                                Click="PauseExtractButton_Click"
                                Visibility="{x:Bind PauseButtonVisibility, Mode=OneWay}"
                                Style="{StaticResource SubtleButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE769;" FontSize="12"/>
                                <TextBlock x:Uid="ExtractPause" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" x:Name="ResumeButton"
                                Click="ResumeExtractButton_Click"
                                Visibility="{x:Bind ResumeButtonVisibility, Mode=OneWay}"
                                Style="{StaticResource SubtleButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE768;" FontSize="12"/>
                                <TextBlock x:Uid="ExtractResume" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3" x:Name="StopButton"
                                Click="StopExtractButton_Click"
                                Visibility="{x:Bind StopButtonVisibility, Mode=OneWay}"
                                Style="{StaticResource SubtleButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE71A;" FontSize="12"/>
                                <TextBlock x:Uid="ExtractStop" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 待转移动包队列([转为移动版改入队] 2026-09-24)
             点「转为移动版」不再直接转换,先把选中的包攒进这张列表,每行单独选纹理缩小档位再统一开转。
             档位文字按需求只写在顶部冻结表头里,行内三个单选不放 Content —— 所以表头和行模板必须共用同一份列宽,
             改一处要改两处,否则标签和它下面的单选圈就错位(全仓没有 SharedSizeGroup/sticky header 先例可抄)。 -->
        <Grid x:Name="MpkgQueueOverlay"
              Visibility="{x:Bind MpkgQueueOverlayVisibility, Mode=OneWay}"
              Grid.RowSpan="3"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              KeyDown="MpkgQueueOverlay_KeyDown">
            <Rectangle x:Name="MpkgQueueOverlayBackground" Fill="#80000000"/>
            <Border x:Name="MpkgQueuePanel"
                    Width="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    CornerRadius="12"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Margin="0,80,0,80">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- 标题栏(固定) -->
                    <Grid Padding="16,12,12,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="8,8,0,0">
                            <FontIcon Glyph="&#xE8F1;" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock x:Uid="MpkgQueueTitle" Style="{StaticResource TitleTextBlockStyle}"
                                   FontSize="18" VerticalAlignment="Center" Margin="8,0,0,0" Grid.Column="1"/>
                        </StackPanel>
                        <Button Grid.Column="2" x:Name="MpkgQueueCloseButton"
                                Click="MpkgQueueClose_Click"
                                Style="{StaticResource SubtleButtonStyle}">
                            <FontIcon Glyph="&#xE711;" FontSize="9"/>
                        </Button>
                    </Grid>
                    <!-- 队列本体:超出滚动,底部总控与按钮不动 -->
                    <ScrollView x:Name="MpkgQueueScroll" Grid.Row="1"
                                VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto"
                                HorizontalScrollMode="Disabled">
                        <ItemsRepeater x:Name="MpkgQueueRepeater" ItemsSource="{x:Bind MpkgQueueItems}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="4"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:MpkgQueueItem">
                                    <!-- 卡片 = 主行 + 可展开的参数条。展开状态挂在行模型上(不是控件里),
                                         所以虚拟化回收控件不会把他点开的那几行悄悄合上。 -->
                                    <StackPanel Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                CornerRadius="6" Margin="12,0,12,0" Padding="16,4,16,6">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="44" Height="44" CornerRadius="6"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                <Image Source="{x:Bind Preview}" Stretch="UniformToFill"/>
                                            </Border>
                                            <!-- 名称 + 档位预警共占这一格:预警要在他人还没展开参数条、
                                                 还没点开始的时候就读得到,放进参数条等于事后解释。
                                                 主行只放一小段短词,长句收进旁边那颗 i 的 ToolTip ——
                                                 一列几十行时,整句话会把行高顶开、把名称挤成两行。 -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name}" FontSize="13"
                                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                                           ToolTipService.ToolTip="{x:Bind Name}"/>
                                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,1,0,0"
                                                            Visibility="{x:Bind ProbeNoteVisibility, Mode=OneWay}">
                                                    <TextBlock Text="{x:Bind ProbeShort, Mode=OneWay}" FontSize="11"
                                                               VerticalAlignment="Center"
                                                               Foreground="{x:Bind ProbeNoteBrush, Mode=OneWay}"/>
                                                    <FontIcon Glyph="&#xE946;" FontSize="11" VerticalAlignment="Center"
                                                            Foreground="{x:Bind ProbeNoteBrush, Mode=OneWay}"
                                                            ToolTipService.ToolTip="{x:Bind ProbeNote, Mode=OneWay}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <!-- 三档各占一格:StepFrequency=1 + SnapsTo=StepValues 让 slider 只能停在 0/1/2
                                                 (WinUI 的 SliderSnapsTo 没有 None,天生就会吸附,所以不会出现"停在半格")。
                                                 刻度用 Inline:BottomRight 要在控件下面另留高度,行高会被顶开。 -->
                                            <Slider Grid.Column="2" x:Name="MpkgTierSlider" x:Uid="MpkgQueue_TierSlider"
                                                    Minimum="0" Maximum="2" StepFrequency="1"
                                                    SnapsTo="StepValues" TickFrequency="1" TickPlacement="Inline"
                                                    IsThumbToolTipEnabled="False" VerticalAlignment="Center"
                                                    Value="{x:Bind TierValue, Mode=TwoWay}" MaxWidth="100"
                                                    IsEnabled="{x:Bind PixelKnobsEnabled, Mode=OneWay}"/>
                                            <TextBlock Grid.Column="3" Text="{x:Bind TierText, Mode=OneWay}" FontSize="13"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <!-- 展开箭头与移除按钮共用最后一列:多开一列就要两边(表头/行模板)同改列宽,
                                                 而总控那根 slider 是靠右边距压在本列之上的,列一多错位概率直线上升。
                                                 自定义模式关着时箭头整列 Collapsed,StackPanel 不给隐藏子项留间距。 -->
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Grid Visibility="{x:Bind SettingsVisibility, Mode=OneWay}">
                                                    <Button x:Name="MpkgQueueExpandButton"
                                                            Style="{StaticResource SubtleButtonStyle}"
                                                            Click="MpkgQueueRowExpand_Click" CommandParameter="{x:Bind}"
                                                            x:Uid="MpkgQueue_Expand">
                                                        <FontIcon Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" FontSize="12"/>
                                                    </Button>
                                                    <!-- 「这行走过别的路」角标:收起来的时候靠它扫队列 -->
                                                    <Ellipse Width="7" Height="7" Fill="#E5A50A" IsHitTestVisible="False"
                                                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0"
                                                             Visibility="{x:Bind OverrideBadgeVisibility, Mode=OneWay}"/>
                                                </Grid>
                                                <Button x:Name="MpkgQueueRemoveButton"
                                                        Style="{StaticResource SubtleButtonStyle}"
                                                        Click="MpkgQueueRemove_Click" CommandParameter="{x:Bind}"
                                                        x:Uid="MpkgQueue_Remove">
                                                    <FontIcon Glyph="&#xE738;" FontSize="12"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <!-- 参数条:一个开关一格 SettingsCard(仓库既有口径,Info 页就是这么摆的),
                                             标签在左、开关在右,卡片自带的描边天然把各项分开,不再自己拼 2x2 网格。
                                             绑的就是行模型,所以改一下立刻进 Snapshot,没有"提交"这一步。
                                             摆法是"父在上、子缩进":纹理原样保留管着像素那三格(外加主行那根倍数 slider),
                                             所以它单独占第一格,受它管的三格往里缩一格排它下面;不相干的另起一段。 -->
                                        <StackPanel Visibility="{x:Bind ExpandedVisibility, Mode=OneWay}" Margin="0,8,0,0">
                                            <!-- 每格都带 ToolTip 说清"这格管什么、关/开的后果",而不只是改个名:
                                                 这些键的默认值都是刻意选的,不知道后果就会随手翻。 -->
                                            <controls:SettingsCard x:Uid="MpkgQueue_CopyTextures"
                                                                   MinHeight="44" Padding="12,6,12,6" Margin="0,0,0,2">
                                                <ToggleSwitch x:Name="MpkgQueueEditCopyTextures" IsOn="{x:Bind CopyTexturesOn, Mode=TwoWay}"/>
                                            </controls:SettingsCard>
                                            <controls:SettingsCard x:Uid="MpkgQueue_Etc2Card"
                                                                   MinHeight="44" Padding="12,6,12,6" Margin="8,0,8,2">
                                                <controls:SettingsCard.Header>
                                                    <StackPanel>
                                                        <TextBlock x:Uid="MpkgQueue_Etc2"/>
                                                        <!-- 置灰理由就地摆一行:光让开关点不动,只会让人以为是控件坏了。
                                                             这格只在原始档(不许 ETC2)时出现。 -->
                                                        <TextBlock x:Uid="MpkgQueue_Etc2Reason" FontSize="11" TextWrapping="Wrap"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   Visibility="{x:Bind Etc2ReasonVisibility, Mode=OneWay}"/>
                                                    </StackPanel>
                                                </controls:SettingsCard.Header>
                                                <ToggleSwitch x:Name="MpkgQueueEditEtc2" IsOn="{x:Bind Etc2On, Mode=TwoWay}"
                                                              IsEnabled="{x:Bind Etc2Enabled, Mode=OneWay}"/>
                                            </controls:SettingsCard>
                                            <controls:SettingsCard x:Uid="MpkgQueue_ShrinkDx"
                                                                   MinHeight="44" Padding="12,6,12,6" Margin="8,0,8,2">
                                                <!-- 生效值与置灰都由父决定:照搬开着时没有 DXT 载荷会被解码,所以这格必然false -->
                                                <ToggleSwitch x:Name="MpkgQueueEditShrinkDx" IsOn="{x:Bind ShrinkDxOn, Mode=TwoWay}"
                                                              IsEnabled="{x:Bind PixelKnobsEnabled, Mode=OneWay}"/>
                                            </controls:SettingsCard>
                                            <controls:SettingsCard x:Uid="MpkgQueue_UseLz4"
                                                                   MinHeight="44" Padding="12,6,12,6" Margin="8,0,8,2">
                                                <!-- 照搬开着时 LZ4 也没有对象(它只作用于物化出来的 mip),
                                                     所以跟着父一起置灰;但值本身照旧显示、照旧发进清单 ——
                                                     repkg 故意不改它,这里也不能改,否则清单和读数会互相打脸。 -->
                                                <ToggleSwitch x:Name="MpkgQueueEditUseLz4" IsOn="{x:Bind UseLz4On, Mode=TwoWay}"
                                                              IsEnabled="{x:Bind PixelKnobsEnabled, Mode=OneWay}"/>
                                            </controls:SettingsCard>
                                            <controls:SettingsCard x:Uid="MpkgQueue_KeepAudio"
                                                                   MinHeight="44" Padding="12,6,12,6" Margin="0,10,0,2">
                                                <ToggleSwitch x:Name="MpkgQueueEditKeepAudio" IsOn="{x:Bind KeepAudioOn, Mode=TwoWay}"/>
                                            </controls:SettingsCard>
                                            <controls:SettingsCard x:Uid="MpkgQueue_ShaderCompat"
                                                                   MinHeight="44" Padding="12,6,12,6" Margin="0,0,0,2">
                                                <ToggleSwitch x:Name="MpkgQueueEditShaderCompat" IsOn="{x:Bind ShaderCompatOn, Mode=TwoWay}"/>
                                            </controls:SettingsCard>
                                            <!-- 重命名那格不叫"包名":手机读的是包内 project.json 的 title,
                                                 这格只管磁盘上的 .mpkg 叫什么。所以二选一直接摆出来,不叫开关。
                                                 没有 ID 的壁纸(导入/自制)整组置灰并就地给理由 ——
                                                 选了 ID 也会悄悄退回标题,那比点不动更坏。 -->
                                            <controls:SettingsCard x:Uid="MpkgQueue_RenameFileCard"
                                                                   MinHeight="44" Padding="12,6,12,6" Margin="0,0,0,2">
                                                <controls:SettingsCard.Header>
                                                    <StackPanel>
                                                        <TextBlock x:Uid="MpkgQueue_RenameFile"/>
                                                        <TextBlock x:Uid="MpkgQueue_RenameFileReason" FontSize="11" TextWrapping="Wrap"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   Visibility="{x:Bind NameIdReasonVisibility, Mode=OneWay}"/>
                                                    </StackPanel>
                                                </controls:SettingsCard.Header>
                                                <RadioButtons x:Name="MpkgQueueEditName" MaxColumns="2"
                                                              SelectedIndex="{x:Bind NameModeIndex, Mode=TwoWay}"
                                                              IsEnabled="{x:Bind NameIdEnabled, Mode=OneWay}">
                                                    <RadioButton x:Uid="MpkgQueue_NameByTitle"/>
                                                    <RadioButton x:Uid="MpkgQueue_NameById"/>
                                                </RadioButtons>
                                            </controls:SettingsCard>
                                            <Button x:Name="MpkgQueueResetButton" x:Uid="MpkgQueue_Reset"
                                                    Margin="0,6,0,0" Padding="10,5,10,6" HorizontalAlignment="Left"
                                                    Click="MpkgQueueRowReset_Click" CommandParameter="{x:Bind}"
                                                    Style="{StaticResource DefaultButtonStyle}"
                                                    Visibility="{x:Bind ResetVisibility, Mode=OneWay}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollView>
                    <!-- 总控区两排:上排档位、下排文件重命名。档位排的列宽与行模板逐列一致(44/*/100/40/Auto),
                         所以 slider 正好压在各行 slider 上、倍数文字正好压在各行 1×/2×/4× 上;
                         它仍叫 MpkgQueueMasterRow(代码按自定义模式改它的右边距),外层这个 StackPanel 只负责把两排摞起来。 -->
                    <StackPanel Grid.Row="2">
                        <StackPanel x:Name="MpkgQueueMasterRow" Orientation="Horizontal" Spacing="6"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,10,86,0">
                            <TextBlock x:Uid="MpkgQueue_ColReduction" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                            <FontIcon Glyph="&#xE946;" FontSize="12" VerticalAlignment="Center"
                                      Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="0,2,0,0">
                                <ToolTipService.ToolTip>
                                    <ToolTip x:Uid="MpkgQueue_ReductionTip"/>
                                </ToolTipService.ToolTip>
                            </FontIcon>
                            <Slider x:Name="MpkgQueueMasterSlider" x:Uid="MpkgQueue_Master"
                                    Minimum="0" Width="100" Maximum="2" StepFrequency="1"
                                    SnapsTo="StepValues" TickFrequency="1" TickPlacement="Inline"
                                    IsThumbToolTipEnabled="False" VerticalAlignment="Center"
                                    Value="{x:Bind MasterTierValue, Mode=TwoWay}"/>
                            <TextBlock Text="{x:Bind MasterTierText, Mode=OneWay}" FontSize="13"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" Margin="18,0,0,0"/>
                        </StackPanel>
                        <!-- 重命名总控:挪一下就是把所有行放回"跟随总控"并把默认改成这一档(见 MasterNameModeValue)。
                             故意不逐行写死值 —— 那样几十行会一起亮角标,角标就废了。 -->
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Margin="0,0,40,0">
                            <TextBlock x:Uid="MpkgQueue_RenameFile" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="0,6,0,0">
                                <ToolTipService.ToolTip>
                                    <ToolTip x:Uid="MpkgQueue_MasterRenameTip"/>
                                </ToolTipService.ToolTip>
                            </TextBlock>
                            <RadioButtons x:Name="MpkgQueueMasterNameRadio" MaxColumns="2" VerticalAlignment="Center"
                                          SelectedIndex="{x:Bind MasterNameModeValue, Mode=TwoWay}">
                                <RadioButton x:Uid="MpkgQueue_NameByTitle"/>
                                <RadioButton x:Uid="MpkgQueue_NameById"/>
                            </RadioButtons>
                        </StackPanel>
                    </StackPanel>
                    <!-- 按钮栏(固定):左边队列计数,按钮靠右 -->
                    <Grid Grid.Row="3" Padding="24,12,24,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="MpkgQueueCountText" Text="" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <!-- 自定义模式:开了才在每行露出「逐行设置」按钮。它是模式开关不是某行的状态,
                                 所以关掉会把已写的逐行覆盖一并清掉(ToolTip 里写明)。 -->
                            <ToggleButton x:Name="MpkgQueueCustomButton" x:Uid="MpkgQueue_Custom"
                                          Checked="MpkgQueueCustom_Changed" Unchecked="MpkgQueueCustom_Changed"/>
                            <Button x:Name="MpkgQueueClearButton" x:Uid="MpkgQueue_Clear"
                                    Click="MpkgQueueClear_Click" Style="{StaticResource DefaultButtonStyle}"/>
                            <Button x:Name="MpkgQueueStartButton" x:Uid="MpkgQueue_Start"
                                    Click="MpkgQueueStart_Click" Style="{StaticResource AccentButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 属性浮层面板 -->
    </Grid>
</Page>
