<?xml version="1.0" encoding="utf-8"?>
<winuiex:WindowEx
    x:Class="WE_Tool.Views.ScenePreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winuiex="using:WinUIEx"
    mc:Ignorable="d"
    MinWidth="720"
    MinHeight="360">

    <winuiex:WindowEx.SystemBackdrop>
        <DesktopAcrylicBackdrop/>
    </winuiex:WindowEx.SystemBackdrop>

    <!-- 场景壁纸预览副窗口(母进程带 scene-preview-window 开关自我启动的子进程)。
         左半是 WebWallGL 的实时画面(WebView2 由 ScenePreviewHost 在代码里建出来塞进 SurfaceHost),
         右半是这张壁纸的属性表:改一行就经宿主转成库的 setProperties,画面当场跟着变。
         标题带是自己画的(48 高、整条 IsHitTestVisible=False 所以能拖),但 WebView2 只住在第二行:
         它不进这条带,系统三键就不会被它的窗口层压掉(主窗口那套 Passthrough 的量这里不需要)。
         整窗不做 x:Bind:Window 不是 FrameworkElement,窗口根上会踩 XamlCompiler 的 CS1503。 -->
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <!-- 行高只是个起点:真值由代码按 AppWindow.TitleBar.Height ÷ RasterizationScale 校准,
                 固定 48 在部分 DPI 下会和右边那三个按钮差 1~2px(同主窗口的 SyncTitleBarRowToCaptionButtons) -->
            <RowDefinition x:Name="TitleBarRow" Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" IsHitTestVisible="False">
            <TextBlock x:Name="HeaderText"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsTextSelectionEnabled="True"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <!-- 比例预览模式下这列被收成 0(见代码里的 ApplyMode):那两种是"只看比例"的纯净面,
                     留一条空栏会把预览挤窄,比例读数就不准了 -->
                <ColumnDefinition x:Name="PropsColumn" Width="320"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="SurfaceHost" Grid.Column="0" Background="Black">
                <StackPanel x:Name="NeedRuntimeNotice" Visibility="Collapsed"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Spacing="8" Padding="28,0,28,0" MaxWidth="460">
                    <TextBlock x:Uid="ScenePreview_NeedRuntime" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"/>
                    <HyperlinkButton x:Uid="ScenePreview_InstallLink" FontSize="14" HorizontalAlignment="Center"
                                     NavigateUri="https://developer.microsoft.com/en-us/microsoft-edge/webview2/"/>
                </StackPanel>
            </Grid>

            <!-- 属性表:行由代码构建(WallpaperPropertyRowBuilder),与属性副窗/详情页面板同一份实现。
                 不用 DataTemplate 也不用 ItemsRepeater——AOT 下窗口内的这两条都不稳,同 PropertiesWindow 的结论 -->
            <Border x:Name="PropsPane" Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" x:Uid="PropertiesPanel_Header"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Margin="16,14,16,8"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="16,4,16,16" Spacing="12">
                            <ProgressRing x:Name="PropsRing" Width="28" Height="28"
                                          HorizontalAlignment="Center" Visibility="Collapsed"/>
                            <TextBlock x:Name="PropsEmptyHint" x:Uid="PropertyPanel_NoProperties"
                                       HorizontalAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="Collapsed"/>
                            <StackPanel x:Name="PropertyItemsHost"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 状态读数:初始化失败、内核报错、首帧耗时都只从这一行出来,不留黑屏给用户猜 -->
        <TextBlock x:Name="StatusText" Grid.Row="2" FontSize="12" Margin="12,6,12,8"
                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Grid>
</winuiex:WindowEx>
