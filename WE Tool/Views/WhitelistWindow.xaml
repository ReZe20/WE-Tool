<winuiex:WindowEx
    x:Class="WE_Tool.Views.WhitelistWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:winuiex="using:WinUIEx"
    xmlns:models="using:WE_Tool.ViewModels"
    Title=""
    Width="900" Height="600"
    MinWidth="600" MinHeight="400">
    <winuiex:WindowEx.SystemBackdrop>
        <DesktopAcrylicBackdrop/>
    </winuiex:WindowEx.SystemBackdrop>

    <Grid Background="Transparent" Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Spacing="2">
            <TextBlock x:Uid="WhitelistWindow_Title" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock x:Name="SubtitleText" FontSize="14"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- 空状态 -->
        <StackPanel x:Name="EmptyState" Grid.Row="1"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
            <FontIcon Glyph="&#xE72E;" FontSize="64"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Uid="WhitelistWindow_EmptyHint" FontSize="16"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Uid="WhitelistWindow_EmptyDesc" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center"/>
        </StackPanel>

        <!-- 卡片列表 -->
        <GridView x:Name="CardGridView" Grid.Row="1"
                  Visibility="Collapsed"
                  SelectionMode="None"
                  SizeChanged="CardGridView_SizeChanged">
            <GridView.ItemContainerTransitions>
                <TransitionCollection>
                    <RepositionThemeTransition/>
                    <AddDeleteThemeTransition/>
                </TransitionCollection>
            </GridView.ItemContainerTransitions>
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="5"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" ItemHeight="300" ItemWidth="300"/>
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:CleanupCardViewModel">
                    <Border CornerRadius="8"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            Padding="14">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 标题行:类型标签 + ID -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind FolderId}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind FullPath}"/>
                                <Border Grid.Column="1" CornerRadius="4"
                                        Background="{ThemeResource TextFillColorSecondaryBrush}">
                                    <TextBlock Text="{x:Bind TypeLabel}" FontSize="11"
                                               Foreground="Black" Margin="6,2"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <!-- 统计 -->
                            <TextBlock Grid.Row="1" Text="{x:Bind StatsText}" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                            <!-- 文件列表 -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{x:Bind Files}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:CleanupFileItem">
                                            <Grid ColumnSpacing="8" Padding="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Name}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTipService.ToolTip="{x:Bind Name}"/>
                                                <TextBlock Grid.Column="1" Text="{x:Bind SizeText}"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- 底部行:左边 CheckBox + 右边操作按钮 -->
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox MinWidth="0"
                                          VerticalAlignment="Center"
                                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                          Click="SelectCheckBox_Click"
                                          Tag="{x:Bind}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            HorizontalAlignment="Right" Spacing="8">
                                    <Button x:Uid="WhitelistWindow_OpenFolder" Click="OpenFolder_Click"
                                            CommandParameter="{x:Bind}"/>
                                    <Button x:Uid="WhitelistWindow_Remove" Click="RemoveFromWhitelist_Click"
                                            CommandParameter="{x:Bind}"
                                            Style="{StaticResource AccentButtonStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- 底部 CommandBar -->
        <CommandBar x:Name="ActionBar" Grid.Row="2"
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    DefaultLabelPosition="Right">
            <CommandBar.PrimaryCommands>
                <AppBarButton x:Name="BatchRemoveButton" x:Uid="WhitelistWindow_BatchRemove" Click="BatchRemove_Click" IsEnabled="False" Foreground="Red">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74D;"/></AppBarButton.Icon>
                </AppBarButton>
            </CommandBar.PrimaryCommands>
        </CommandBar>
    </Grid>
</winuiex:WindowEx>
