<?xml version="1.0" encoding="utf-8"?>
<winuiex:WindowEx
    x:Class="WE_Tool.PropertiesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WE_Tool"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:models="using:WE_Tool.Models"
    xmlns:converters="using:WE_Tool.Converters"
    xmlns:winuiex="using:WinUIEx"
    MinWidth="480"
    MinHeight="400">
    <winuiex:WindowEx.SystemBackdrop>
        <DesktopAcrylicBackdrop/>
    </winuiex:WindowEx.SystemBackdrop>
    <!-- 注意:Window 不是 FrameworkElement。本文件全部用普通 Binding(DataContext 在 code-behind 设置),
        不能用 x:Bind——x:Bind + StaticResource 转换器会让 XamlCompiler 生成 SetConverterLookupRoot(Window),
        CS1503 编译失败 -->
    <Grid Background="Transparent">
        <Grid.Resources>
        <!-- 属性行模板：分组标题(<hr> 纯文本) / group 类型 Expander(递归渲染子属性) / 属性行(标签+控件) 按标志切换。
             从 Papers.xaml 搬入,x:Bind 改普通 Binding(窗口内禁用 x:Bind+StaticResource) -->
        <DataTemplate x:Key="PropertyRowTemplate">
            <Grid>
                <StackPanel Visibility="{Binding GroupHeaderVisibility, Mode=OneWay}">
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,6,0,10"/>
                    <TextBlock Text="{Binding DisplayText}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="14"
                               TextAlignment="{Binding TextAlignmentValue, Mode=OneWay}"/>
                </StackPanel>
                <!-- group 类型 → Expander 折叠组（默认折叠：组内子属性不展开渲染，大量分组壁纸切换不卡；点击组标题展开） -->
                <Expander Visibility="{Binding GroupBorderVisibility, Mode=OneWay}"
                          IsExpanded="False"
                          HorizontalAlignment="Stretch"
                          Margin="0,4">
                    <Expander.Header>
                        <TextBlock Text="{Binding DisplayText}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                   TextAlignment="{Binding TextAlignmentValue, Mode=OneWay}"/>
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding Children, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <StaticResource ResourceKey="PropertyRowTemplate"/>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
                <!-- 属性行：左标签 + 右控件两列布局（RowVisibility 含 condition 条件） -->
                <Grid Visibility="{Binding RowVisibility, Mode=OneWay}" Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- 标签：纯文本（含 HTML 样式：字号/粗体/居中/文字色） -->
                    <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" VerticalAlignment="Center"
                               FontSize="{Binding TextFontSize, Mode=OneWay}"
                               FontWeight="{Binding TextFontWeight, Mode=OneWay}"
                               TextAlignment="{Binding TextAlignmentValue, Mode=OneWay}"/>
                    <Grid Grid.Column="1" Margin="12,0,0,0">
                        <CheckBox Visibility="{Binding BoolVisibility, Mode=OneWay}"
                                  IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                  MinWidth="0"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"/>
                        <Slider Visibility="{Binding SliderVisibility, Mode=OneWay}"
                                Value="{Binding SliderValue, Mode=TwoWay}"
                                Minimum="{Binding SliderMin, Mode=OneWay}"
                                Maximum="{Binding SliderMax, Mode=OneWay}"
                                StepFrequency="{Binding SliderStep, Mode=OneWay}"
                                Width="140"
                                VerticalAlignment="Center"/>
                        <ComboBox Visibility="{Binding ComboVisibility, Mode=OneWay}"
                                  ItemsSource="{Binding Options, Mode=OneWay}"
                                  SelectedIndex="{Binding ComboIndex, Mode=TwoWay}"
                                  MinWidth="140"
                                  VerticalAlignment="Center"/>
                        <Button Visibility="{Binding ColorVisibility, Mode=OneWay}" Padding="8,4" VerticalAlignment="Center">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Rectangle Width="14" Height="14" Fill="{Binding ColorBrush, Mode=OneWay}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ColorHexText, Mode=OneWay}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                            <Button.Flyout>
                                <Flyout>
                                    <ColorPicker Color="{Binding ColorValue, Mode=TwoWay}"
                                                 IsAlphaEnabled="False"
                                                 IsColorPreviewVisible="False"
                                                 IsColorSpectrumVisible="True"
                                                 IsColorSliderVisible="True"
                                                 IsHexInputVisible="True"/>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <TextBox Visibility="{Binding TextInputVisibility, Mode=OneWay}"
                                 Text="{Binding TextValue, Mode=TwoWay}"
                                 TextWrapping="Wrap"
                                 Width="180"
                                 VerticalAlignment="Center"/>
                        <Button Visibility="{Binding FilePathVisibility, Mode=OneWay}"
                                Command="{Binding PickFileCommand}"
                                Content="{Binding FilePathDisplay, Mode=OneWay}"
                                MaxWidth="180"
                                Padding="10,4"
                                VerticalAlignment="Center"/>
                        <TextBlock Visibility="{Binding ReadOnlyVisibility, Mode=OneWay}"
                                   Text="{Binding DisplayValue}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- 自定义标题栏:去系统标题栏后顶部留空(Tall 高度 48),显示亚克力背景 -->
        <Grid Grid.Row="0" IsHitTestVisible="False">
            <TextBlock x:Uid="PropertiesPanel_Header"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsTextSelectionEnabled="True"/>
        </Grid>
        <!-- 双页导航:文件属性(预览/信息/文件树) / 壁纸属性(可编辑属性列表+保存) -->
        <NavigationView Grid.Row="1"
                        PaneDisplayMode="Top"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="False"
                        SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="PropertiesWindow_FileInfo" Tag="file" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="PropertiesWindow_WallpaperProps" Tag="props">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.Content>
                <Grid>
                    <!-- ========== 文件属性页 ========== -->
                    <ScrollViewer x:Name="ContentRoot" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Resources>
                            <converters:FileSizeToString x:Key="FileSizeToString"/>
                            <converters:TypeToDisplay x:Key="TypeToDisplay"/>
                            <converters:SourceToDisplay x:Key="SourceToDisplay"/>
                            <converters:RatingToDisplay x:Key="RatingToDisplay"/>
                            <converters:TagToDisplay x:Key="TagToDisplay"/>
                            <converters:DescriptionToDisplay x:Key="DescriptionToDisplay"/>
                            <converters:DateTimeToString x:Key="DateTimeToString"/>

                            <!-- TreeView 文件结构模板 -->
                            <DataTemplate x:Key="FileTreeFolderTemplate">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                                    <TextBlock Text="{Binding Content.DisplayText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                            <DataTemplate x:Key="FileTreeImageTemplate">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xEB9F;" FontSize="14"/>
                                    <TextBlock Text="{Binding Content.DisplayText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                            <DataTemplate x:Key="FileTreeVideoTemplate">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B2;" FontSize="14"/>
                                    <TextBlock Text="{Binding Content.DisplayText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                            <DataTemplate x:Key="FileTreeDocumentTemplate">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="14"/>
                                    <TextBlock Text="{Binding Content.DisplayText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                            <DataTemplate x:Key="FileTreeOtherTemplate">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE7C3;" FontSize="14"/>
                                    <TextBlock Text="{Binding Content.DisplayText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                            <models:FileTreeTemplateSelector x:Key="FileTreeTemplateSelector"
                                                             FolderTemplate="{StaticResource FileTreeFolderTemplate}"
                                                             ImageTemplate="{StaticResource FileTreeImageTemplate}"
                                                             VideoTemplate="{StaticResource FileTreeVideoTemplate}"
                                                             DocumentTemplate="{StaticResource FileTreeDocumentTemplate}"
                                                             OtherTemplate="{StaticResource FileTreeOtherTemplate}"/>
                        </ScrollViewer.Resources>
                        <StackPanel Padding="24,20,24,16" Spacing="0">
                            <!-- 壁纸预览图 -->
                            <Border Width="200" Height="200" HorizontalAlignment="Center"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4">
                                <Image Source="{Binding Preview, Mode=OneWay, FallbackValue=null}" Stretch="Uniform"/>
                            </Border>
                            <!-- 壁纸标题 -->
                            <TextBlock Text="{Binding Title, Mode=OneWay, FallbackValue=''}"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       FontSize="28"
                                       FontWeight="SemiBold"
                                       Padding="0,20,0,4"
                                       TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True"/>

                            <!-- 基本信息 -->
                            <TextBlock x:Uid="PropertiesPanel_BasicInfo"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       FontWeight="SemiBold"
                                       Margin="0,8,0,8"
                                       Foreground="{ThemeResource SystemAccentColor}" IsTextSelectionEnabled="True"/>
                            <Grid ColumnSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Type -->
                                <TextBlock Grid.Row="0" Grid.Column="0" x:Uid="PropertiesPanel_TypeLabel"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="Gray" Margin="0,4,0,4" IsTextSelectionEnabled="True"/>
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{Binding Type, Mode=OneWay, Converter={StaticResource TypeToDisplay}, FallbackValue='-'}"
                                           Style="{StaticResource BodyTextBlockStyle}" Margin="0,4,0,4" IsTextSelectionEnabled="True"/>
                                <!-- Source -->
                                <TextBlock Grid.Row="1" Grid.Column="0" x:Uid="PropertiesPanel_SourceLabel"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="Gray" Margin="0,4,0,4" IsTextSelectionEnabled="True"/>
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{Binding Source, Mode=OneWay, Converter={StaticResource SourceToDisplay}, FallbackValue='-'}"
                                           Style="{StaticResource BodyTextBlockStyle}" Margin="0,4,0,4" IsTextSelectionEnabled="True"/>
                                <!-- ContentRating -->
                                <TextBlock Grid.Row="2" Grid.Column="0" x:Uid="PropertiesPanel_RatingLabel"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="Gray" Margin="0,4,0,4" IsTextSelectionEnabled="True"/>
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           Text="{Binding ContentRating, Mode=OneWay, Converter={StaticResource RatingToDisplay}, FallbackValue='-'}"
                                           Style="{StaticResource BodyTextBlockStyle}" Margin="0,4,0,4" IsTextSelectionEnabled="True"/>
                                <!-- Tags -->
                                <TextBlock Grid.Row="3" Grid.Column="0" x:Uid="PropertiesPanel_TagLabel"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="Gray" Margin="0,4,0,4" IsTextSelectionEnabled="True"/>
                                <TextBlock Grid.Row="3" Grid.Column="1"
                                           Text="{Binding Tags, Mode=OneWay, Converter={StaticResource TagToDisplay}, FallbackValue='-'}"
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,4" IsTextSelectionEnabled="True"/>
                                <!-- Description -->
                                <TextBlock Grid.Row="4" Grid.Column="0"
                                           x:Uid="Description"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="Gray" Margin="0,4,0,4" IsTextSelectionEnabled="True"/>
                                <TextBlock Grid.Row="4" Grid.Column="1"
                                           Text="{Binding Description, Mode=OneWay, Converter={StaticResource DescriptionToDisplay}, FallbackValue='-'}"
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           TextWrapping="Wrap"
                                           TextTrimming="None"
                                           Margin="0,4,0,4" IsTextSelectionEnabled="True"/>
                            </Grid>

                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,8,0,8"/>

                            <!-- 文件信息 -->
                            <TextBlock x:Uid="PropertiesPanel_FileInfo"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       FontWeight="SemiBold"
                                       Margin="0,8,0,8"
                                       Foreground="{ThemeResource SystemAccentColor}" IsTextSelectionEnabled="True"/>
                            <Grid ColumnSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- FileSize -->
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           x:Uid="FileSize"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="Gray" Margin="0,4,0,4" IsTextSelectionEnabled="True"/>
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{Binding FileSize, Mode=OneWay, Converter={StaticResource FileSizeToString}, FallbackValue='-'}"
                                           Style="{StaticResource BodyTextBlockStyle}" Margin="0,4,0,4" IsTextSelectionEnabled="True"/>
                                <!-- AcfSize (壁纸大小) -->
                                <TextBlock Grid.Row="1" Grid.Column="0" x:Uid="AcfSize"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="Gray" Margin="0,4,0,4" IsTextSelectionEnabled="True"/>
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{Binding AcfSize, Mode=OneWay, Converter={StaticResource FileSizeToString}, FallbackValue='-'}"
                                           Style="{StaticResource BodyTextBlockStyle}" Margin="0,4,0,4" IsTextSelectionEnabled="True"/>
                                <!-- FolderPath -->
                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           x:Uid="FolderPath"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="Gray" Margin="0,4,0,4" IsTextSelectionEnabled="True"/>
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           Text="{Binding FolderPath, Mode=OneWay, FallbackValue='-'}"
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,4" IsTextSelectionEnabled="True"/>
                                <!-- WorkshopID -->
                                <TextBlock Grid.Row="3" Grid.Column="0" x:Uid="WorkshopID"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="Gray" Margin="0,4,0,4" IsTextSelectionEnabled="True"/>
                                <TextBlock Grid.Row="3" Grid.Column="1"
                                           Text="{Binding WorkshopID, Mode=OneWay, FallbackValue='-'}"
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           IsTextSelectionEnabled="True"
                                           Margin="0,4,0,4"/>
                                <!-- Dependency -->
                                <TextBlock Grid.Row="4" Grid.Column="0" x:Uid="Dependency"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="Gray" Margin="0,4,0,4" IsTextSelectionEnabled="True"/>
                                <TextBlock Grid.Row="4" Grid.Column="1"
                                           Text="{Binding Dependency, Mode=OneWay, FallbackValue='-'}"
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,4" IsTextSelectionEnabled="True"/>
                            </Grid>

                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,8,0,8"/>

                            <!-- 时间信息 -->
                            <TextBlock x:Uid="PropertiesPanel_TimeInfo"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       FontWeight="SemiBold"
                                       Margin="0,8,0,8"
                                       Foreground="{ThemeResource SystemAccentColor}" IsTextSelectionEnabled="True"/>
                            <Grid ColumnSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- CreationTime -->
                                <TextBlock Grid.Row="0" Grid.Column="0" x:Uid="CreationTime"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="Gray" Margin="0,4,0,4" IsTextSelectionEnabled="True"/>
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{Binding CreationTime, Mode=OneWay, Converter={StaticResource DateTimeToString}, FallbackValue='-'}"
                                           Style="{StaticResource BodyTextBlockStyle}" Margin="0,4,0,4" IsTextSelectionEnabled="True"/>
                                <!-- UpdateTime -->
                                <TextBlock Grid.Row="1" Grid.Column="0" x:Uid="UpdateTime"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="Gray" Margin="0,4,0,4" IsTextSelectionEnabled="True"/>
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{Binding UpdateTime, Mode=OneWay, Converter={StaticResource DateTimeToString}, FallbackValue='-'}"
                                           Style="{StaticResource BodyTextBlockStyle}" Margin="0,4,0,4" IsTextSelectionEnabled="True"/>
                                <!-- AcfUpdateTime -->
                                <TextBlock Grid.Row="2" Grid.Column="0" x:Uid="AcfUpdateTime"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="Gray" Margin="0,4,0,4" IsTextSelectionEnabled="True"/>
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           Text="{Binding AcfUpdateTime, Mode=OneWay, Converter={StaticResource DateTimeToString}, FallbackValue='-'}"
                                           Style="{StaticResource BodyTextBlockStyle}" Margin="0,4,0,4" IsTextSelectionEnabled="True"/>
                            </Grid>

                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,8,0,8"/>

                            <TextBlock x:Uid="FileStructure"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       FontWeight="SemiBold"
                                       Margin="0,8,0,6"
                                       Foreground="{ThemeResource SystemAccentColor}" IsTextSelectionEnabled="True"/>
                            <TreeView x:Name="FileStructureTree"
                                      MaxHeight="200"
                                      Margin="0,0,0,4"
                                      Expanding="FileStructureTree_Expanding"
                                      DoubleTapped="FileStructureTree_DoubleTapped"
                                      ItemTemplateSelector="{StaticResource FileTreeTemplateSelector}"
                                      CanDragItems="False" CanReorderItems="False" AllowDrop="False"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ========== 壁纸属性页(DataContext = 窗口实例,绑定窗口的 Properties 等) ========== -->
                    <Grid x:Name="WallpaperPropsRoot" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Padding="24,16,24,16" Spacing="15">
                                <Button x:Name="PropertySaveButton"
                                        x:Uid="PropertyPanel_Save"
                                        Click="PropertySaveButton_Click"
                                        HorizontalAlignment="Left"/>
                                <ProgressRing x:Name="PropertyPanelLoadingRing"
                                              IsActive="{Binding IsPropertyLoading, Mode=OneWay}"
                                              Visibility="{Binding PropertyPanelLoadingVisibility, Mode=OneWay}"
                                              Width="36"
                                              Height="36"
                                              HorizontalAlignment="Center"/>
                                <TextBlock x:Name="PropertyPanelEmptyHint"
                                           x:Uid="PropertyPanel_NoProperties"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="16"
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding PropertyEmptyHintVisibility, Mode=OneWay}"/>
                                <ItemsControl x:Name="PropertyItemsControl"
                                              ItemsSource="{Binding Properties, Mode=OneWay}"
                                              Visibility="{Binding PropertyListVisibility, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <StaticResource ResourceKey="PropertyRowTemplate"/>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </NavigationView.Content>
        </NavigationView>
    </Grid>

</winuiex:WindowEx>
