<?xml version="1.0" encoding="utf-8"?>
<winuiex:WindowEx
    x:Class="WE_Tool.PropertiesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WE_Tool"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:models="using:WE_Tool.Models"
    xmlns:converters="using:WE_Tool.Converters"
    xmlns:winuiex="using:WinUIEx"
    MinWidth="480"
    MinHeight="400">
    <winuiex:WindowEx.SystemBackdrop>
        <DesktopAcrylicBackdrop/>
    </winuiex:WindowEx.SystemBackdrop>
    <!-- 注意:Window 不是 FrameworkElement。本文件全部用普通 Binding(DataContext 在 code-behind 设置),
        不能用 x:Bind——x:Bind + StaticResource 转换器会让 XamlCompiler 生成 SetConverterLookupRoot(Window),
        CS1503 编译失败 -->
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.Resources>
        <!-- 属性行模板：分组标题(<hr> 纯文本) / group 类型 Expander(递归渲染子属性) / 属性行(标签+控件) 按标志切换。
             从 Papers.xaml 搬入,x:Bind 改普通 Binding(窗口内禁用 x:Bind+StaticResource) -->
        <DataTemplate x:Key="PropertyRowTemplate">
            <Grid>
                <StackPanel Visibility="{Binding GroupHeaderVisibility, Mode=OneWay}">
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,6,0,10"/>
                    <RichTextBlock TextWrapping="Wrap" FontWeight="SemiBold" FontSize="14"
                                   TextAlignment="{Binding TextAlignmentValue, Mode=OneWay}"
                                   DataContextChanged="TextBlock_DataContextChanged"/>
                </StackPanel>
                <!-- group 类型 → Expander 折叠组（默认折叠：组内子属性不展开渲染，大量分组壁纸切换不卡；点击组标题展开） -->
                <Expander Visibility="{Binding GroupBorderVisibility, Mode=OneWay}"
                          IsExpanded="False"
                          HorizontalAlignment="Stretch"
                          Margin="0,4">
                    <Expander.Header>
                        <RichTextBlock TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold"
                                       TextAlignment="{Binding TextAlignmentValue, Mode=OneWay}"
                                       DataContextChanged="TextBlock_DataContextChanged"/>
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding Children, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <StaticResource ResourceKey="PropertyRowTemplate"/>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
                <!-- 属性行：左标签 + 右控件两列布局（RowVisibility 含 condition 条件） -->
                <Grid Visibility="{Binding RowVisibility, Mode=OneWay}" Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- 标签：纯文本（含 HTML 样式：字号/粗体/居中/文字色） -->
                    <RichTextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                                   FontSize="{Binding TextFontSize, Mode=OneWay}"
                                   FontWeight="{Binding TextFontWeight, Mode=OneWay}"
                                   TextAlignment="{Binding TextAlignmentValue, Mode=OneWay}"
                                   DataContextChanged="TextBlock_DataContextChanged"/>
                    <Grid Grid.Column="1" Margin="12,0,0,0">
                        <CheckBox Visibility="{Binding BoolVisibility, Mode=OneWay}"
                                  IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                  MinWidth="0"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"/>
                        <!-- slider:滑杆 + 右侧当前值文字(Width 100 为文字腾空间) -->
                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    Visibility="{Binding SliderVisibility, Mode=OneWay}"
                                    VerticalAlignment="Center">
                            <Slider Value="{Binding SliderValue, Mode=TwoWay}"
                                    Minimum="{Binding SliderMin, Mode=OneWay}"
                                    Maximum="{Binding SliderMax, Mode=OneWay}"
                                    StepFrequency="{Binding SliderStep, Mode=OneWay}"
                                    Width="100"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SliderValueText, Mode=OneWay}"
                                       MinWidth="40"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- combo:DropDownButton + 动态菜单(显示区为普通 TextBlock,根治 WinUI
                             ComboBox 滚动后 SelectionBoxItem 不刷新的显示空白 bug) -->
                        <DropDownButton Visibility="{Binding ComboVisibility, Mode=OneWay}"
                                        MinWidth="140"
                                        VerticalAlignment="Center"
                                        Click="ComboButton_Click">
                            <TextBlock Text="{Binding ComboDisplayText, Mode=OneWay}"/>
                        </DropDownButton>
                        <Button Visibility="{Binding ColorVisibility, Mode=OneWay}" Padding="8,4" VerticalAlignment="Center">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Rectangle Width="14" Height="14" Fill="{Binding ColorBrush, Mode=OneWay}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ColorHexText, Mode=OneWay}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                            <Button.Flyout>
                                <Flyout Opened="FlyoutThemeRefresh_Opened">
                                    <ColorPicker Color="{Binding ColorValue, Mode=TwoWay}"
                                                 IsAlphaEnabled="False"
                                                 IsColorPreviewVisible="False"
                                                 IsColorSpectrumVisible="True"
                                                 IsColorSliderVisible="True"
                                                 IsHexInputVisible="True"/>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <TextBox Visibility="{Binding TextInputVisibility, Mode=OneWay}"
                                 Text="{Binding TextValue, Mode=TwoWay}"
                                 TextWrapping="Wrap"
                                 Width="180"
                                 VerticalAlignment="Center"/>
                        <Button Visibility="{Binding FilePathVisibility, Mode=OneWay}"
                                Command="{Binding PickFileCommand}"
                                Content="{Binding FilePathDisplay, Mode=OneWay}"
                                MaxWidth="180"
                                Padding="10,4"
                                VerticalAlignment="Center"/>
                        <TextBlock Visibility="{Binding ReadOnlyVisibility, Mode=OneWay}"
                                   Text="{Binding DisplayValue}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>
        <!-- 文件属性页虚拟化行模板:预览/标题/节标题/信息行/分隔线/文件树 单模板按行类型 Visibility 切换
             (同 PropertyRowTemplate 模式);标签/值在 code-behind 预计算(快照语义) -->
        <DataTemplate x:Key="FileInfoRowTemplate">
            <Grid Margin="24,0,24,0">
                <!-- 预览图 -->
                <Border Visibility="{Binding PreviewVisibility, Mode=OneWay}"
                        Width="200" Height="200" HorizontalAlignment="Center"
                        Margin="0,20,0,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4">
                    <Image Source="{Binding Value}" Stretch="Uniform"/>
                </Border>
                <!-- 壁纸标题 -->
                <TextBlock Visibility="{Binding TitleVisibility, Mode=OneWay}" Text="{Binding Value}"
                           Style="{StaticResource SubtitleTextBlockStyle}" FontSize="28" FontWeight="SemiBold"
                           Padding="0,20,0,4" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True"/>
                <!-- 节标题 -->
                <TextBlock Visibility="{Binding SectionVisibility, Mode=OneWay}" Text="{Binding SectionTitle}"
                           Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold"
                           Margin="0,8,0,8" Foreground="{ThemeResource SystemAccentColor}" IsTextSelectionEnabled="True"/>
                <!-- 信息行:左标签(100) + 右值 -->
                <Grid Visibility="{Binding InfoVisibility, Mode=OneWay}" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="Gray" Margin="0,4,0,4" IsTextSelectionEnabled="True"/>
                    <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource BodyTextBlockStyle}"
                               TextWrapping="{Binding ValueWrap}" Margin="0,4,0,4" IsTextSelectionEnabled="True"/>
                </Grid>
                <!-- 分隔线 -->
                <Rectangle Visibility="{Binding DividerVisibility, Mode=OneWay}" Height="1"
                           Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,8,0,8"/>
                <!-- 文件结构树:虚拟化回收后重新实化时由 Loaded 从缓存重建根节点 -->
                <TreeView Visibility="{Binding TreeVisibility, Mode=OneWay}"
                          MaxHeight="200" Margin="0,0,0,20"
                          Loaded="FileStructureTree_Loaded"
                          Expanding="FileStructureTree_Expanding"
                          DoubleTapped="FileStructureTree_DoubleTapped"
                          ItemTemplateSelector="{StaticResource FileTreeTemplateSelector}"
                          CanDragItems="False" CanReorderItems="False" AllowDrop="False"/>
            </Grid>
        </DataTemplate>

        <!-- TreeView 文件结构模板(自 ScrollViewer.Resources 移入:模板内 StaticResource 以定义处解析) -->
        <DataTemplate x:Key="FileTreeFolderTemplate">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                <TextBlock Text="{Binding Content.DisplayText}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="FileTreeImageTemplate">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xEB9F;" FontSize="14"/>
                <TextBlock Text="{Binding Content.DisplayText}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="FileTreeVideoTemplate">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xE8B2;" FontSize="14"/>
                <TextBlock Text="{Binding Content.DisplayText}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="FileTreeDocumentTemplate">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xE8A5;" FontSize="14"/>
                <TextBlock Text="{Binding Content.DisplayText}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="FileTreeOtherTemplate">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xE7C3;" FontSize="14"/>
                <TextBlock Text="{Binding Content.DisplayText}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
        <models:FileTreeTemplateSelector x:Key="FileTreeTemplateSelector"
                                         FolderTemplate="{StaticResource FileTreeFolderTemplate}"
                                         ImageTemplate="{StaticResource FileTreeImageTemplate}"
                                         VideoTemplate="{StaticResource FileTreeVideoTemplate}"
                                         DocumentTemplate="{StaticResource FileTreeDocumentTemplate}"
                                         OtherTemplate="{StaticResource FileTreeOtherTemplate}"/>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- 自定义标题栏:去系统标题栏后顶部留空(Tall 高度 48),显示亚克力背景 -->
        <Grid Grid.Row="0" IsHitTestVisible="False">
            <TextBlock x:Uid="PropertiesPanel_Header"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsTextSelectionEnabled="True"/>
        </Grid>
        <!-- 双页导航:文件属性(预览/信息/文件树) / 壁纸属性(可编辑属性列表+保存) -->
        <NavigationView Grid.Row="1"
                        PaneDisplayMode="Top"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="False"
                        SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="PropertiesWindow_FileInfo" Tag="file" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="WallpaperPropsNavItem" x:Uid="PropertiesWindow_WallpaperProps" Tag="props">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.Content>
                <Grid>
                    <!-- ========== 文件属性页 ========== -->
                    <ScrollViewer x:Name="ContentRoot" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                        <!-- 文件属性页虚拟化列表:ItemsRepeater 由 code-behind 创建(XamlCompiler 对窗口内
                             ItemsRepeater 标签稳定 Pass1 崩溃,同壁纸属性页 PropertyItemsHost 模式);
                             直接挂 ScrollViewer.Content 获得有界视口,StackLayout 才真正虚拟化 -->
                    </ScrollViewer>
                    <!-- ========== 壁纸属性页(DataContext = 窗口实例,绑定窗口的 Properties 等) ========== -->
                    <Grid x:Name="WallpaperPropsRoot" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Padding="24,16,24,16" Spacing="15">
                                <Button x:Name="PropertySaveButton"
                                        x:Uid="PropertyPanel_Save"
                                        Click="PropertySaveButton_Click"
                                        HorizontalAlignment="Left"/>
                                <ProgressRing x:Name="PropertyPanelLoadingRing"
                                              IsActive="{Binding IsPropertyLoading, Mode=OneWay}"
                                              Visibility="{Binding PropertyPanelLoadingVisibility, Mode=OneWay}"
                                              Width="36"
                                              Height="36"
                                              HorizontalAlignment="Center"/>
                                <TextBlock x:Name="PropertyPanelEmptyHint"
                                           x:Uid="PropertyPanel_NoProperties"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="16"
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding PropertyEmptyHintVisibility, Mode=OneWay}"/>
                                <!-- 虚拟化属性列表:ItemsRepeater 由 code-behind 创建(XamlCompiler 对窗口内
                                     ItemsRepeater 标签稳定 Pass1 崩溃,2026-08-10 实测 3 连崩);
                                     combo 已换 DropDownButton(显示区自控),虚拟化重用不再有显示 bug -->
                                <StackPanel x:Name="PropertyItemsHost"
                                            Visibility="{Binding PropertyListVisibility, Mode=OneWay}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </NavigationView.Content>
        </NavigationView>
    </Grid>

</winuiex:WindowEx>
