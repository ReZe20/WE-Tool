<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WE_Tool.LoadPapers"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WE_Tool"
    xmlns:models="using:WE_Tool.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled"
    AllowDrop="True"
    DragOver="Page_DragOver"
    DragLeave="Page_DragLeave"
    Drop="Page_Drop">

    <Page.Resources>
        <!-- 拖放遮罩淡入/淡出 -->
        <Storyboard x:Name="OverlayFadeIn">
            <DoubleAnimation Storyboard.TargetName="DragOverlay"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             Duration="0:0:0.18"/>
        </Storyboard>
        <Storyboard x:Name="OverlayFadeOut">
            <DoubleAnimation Storyboard.TargetName="DragOverlay"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0"
                             Duration="0:0:0.15"/>
        </Storyboard>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="12" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 页面标题 -->
        <TextBlock Grid.Row="0"
                   x:Uid="LoadPapers_Title"
                   FontSize="25"/>

        <!-- 完成/提示反馈 -->
        <InfoBar x:Name="ImportInfoBar"
                 Grid.Row="1"
                 IsOpen="False"
                 IsClosable="True"/>

        <!-- 空状态(队列为空时) -->
        <StackPanel x:Name="EmptyState"
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8">
            <FontIcon Glyph="&#xE8B5;" FontSize="48"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      HorizontalAlignment="Center"/>
            <TextBlock x:Uid="LoadPapers_DragHint"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Uid="LoadPapers_DragSubhint"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- 导入队列(非空时显示) -->
        <ListView x:Name="ImportQueueList"
                  Grid.Row="2"
                  Visibility="Collapsed"
                  SelectionMode="None"
                  ItemsSource="{x:Bind QueueItems}">
            <ListView.ItemContainerTransitions>
                <TransitionCollection>
                    <!-- 加入/删除淡入淡出 + 删除后其它条目平滑补位(WinUI 3 标准 ThemeTransition) -->
                    <AddDeleteThemeTransition/>
                    <RepositionThemeTransition/>
                </TransitionCollection>
            </ListView.ItemContainerTransitions>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ImportQueueItem">
                    <Grid ColumnSpacing="12" Padding="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 正方形圆角后缀卡片 -->
                        <Border Width="48" Height="48"
                                CornerRadius="8"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Extension}"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- 完整路径 + 状态 -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind FilePath}"
                                       TextWrapping="Wrap"
                                       ToolTipService.ToolTip="{x:Bind FilePath}"/>
                            <TextBlock Text="{x:Bind Status, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <ProgressBar Grid.Column="2"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{x:Bind Progress, Mode=OneWay}"
                                     VerticalAlignment="Center"/>

                        <!-- 移除按钮 -->
                        <Button Grid.Column="3"
                                Click="RemoveItem_Click"
                                CommandParameter="{x:Bind}"
                                Width="32" Height="32"
                                MinWidth="0" MinHeight="0"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE711;" FontSize="12"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 操作栏 CommandBar:选择文件常驻,清空/开始提取随队列出现。全部 AppBarButton 统一高度 -->
        <CommandBar x:Name="ActionBar"
                    Grid.Row="3"
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    DefaultLabelPosition="Right">
            <CommandBar.PrimaryCommands>
                <!-- 导出目录:按钮弹出 Flyout,内含文本框 + 选择文件夹 -->
                <AppBarButton x:Name="ExportDirButton" x:Uid="LoadPapers_SetExportDir">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE74E;"/>
                    </AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <Flyout Opened="ExportDirFlyout_Opened">
                            <StackPanel Spacing="8" Width="360">
                                <TextBox x:Name="ExportPathBox"
                                         Text="{x:Bind ExportDirPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         x:Uid="LoadPapers_ExportDirPlaceholder"
                                         TextWrapping="NoWrap"
                                         Width="360"/>
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <Button x:Uid="LoadPapers_ProjectDir"
                                            Click="UseProjectPath_Click"/>
                                    <Button x:Uid="LoadPapers_ExportDir"
                                            Click="UseDownloadPath_Click"/>
                                    <Button x:Uid="LoadPapers_BrowseFolder"
                                            Click="BrowseExportPath_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton x:Name="SelectFileButton" x:Uid="LoadPapers_SelectFile" Click="SelectFiles_Click">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE8E5;"/>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="ScanFolderButton" x:Uid="LoadPapers_ScanFolder" Click="ScanFolder_Click">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE8B7;"/>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="ClearButton"
                              x:Uid="LoadPapers_Clear"
                              Click="ClearQueue_Click">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE74D;"/>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="StartExtractButton"
                              x:Uid="LoadPapers_StartExtract"
                              Click="StartExtractButton_Click"
                              IsEnabled="False">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE768;"/>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="PauseButton"
                              x:Uid="LoadPapers_Pause"
                              Click="PauseButton_Click"
                              IsEnabled="False">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE769;"/>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="StopButton"
                              x:Uid="LoadPapers_Stop"
                              Click="StopButton_Click"
                              IsEnabled="False">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE71A;"/>
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar.PrimaryCommands>
        </CommandBar>

        <!-- 拖放覆盖层(拖入时显示,淡入淡出) -->
        <Grid x:Name="DragOverlay"
              Grid.Row="1"
              Grid.RowSpan="4"
              Visibility="Collapsed"
              IsHitTestVisible="False">
            <Border CornerRadius="8"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    Opacity="0.15"/>
            <Border Margin="8"
                    CornerRadius="8"
                    BorderThickness="2"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"/>
        </Grid>
    </Grid>
</Page>
