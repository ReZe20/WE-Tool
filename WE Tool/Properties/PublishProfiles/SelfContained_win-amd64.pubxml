<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <PublishDir>bin\Package\SelfContained_win-amd64\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <!-- AOT 发布:csproj 已设 PublishAot(Release 开启)+ PublishTrimmed(Release true)。
         这里不能再设 PublishTrimmed=false,否则与 AOT 冲突(PublishTrimmed is implied by native compilation) -->
  </PropertyGroup>
</Project>
